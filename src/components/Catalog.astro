---
import { units } from '../data/catalog.js';

const accents = {
  ochre: 'border-[#e7dcc6] bg-[#fdf9f0] hover:border-[#cdb98f]',
  emerald: 'border-[#d3e5d9] bg-[#f3f9f5] hover:border-[#a6cbb6]',
  sky: 'border-[#d5e4ee] bg-[#f4f9fc] hover:border-[#a5c6da]',
};
---

<section
  id="catalogo"
  data-catalog
  class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8"
>
  <div>
    <h2 class="font-display text-3xl text-ink">Catálogo por unidad</h2>
    <p class="mt-2 text-sm text-slate-500">Elegí una unidad para ver sus temas.</p>
  </div>

  <div
    class="mt-8 flex gap-6 border-b border-slate-200"
    role="group"
    aria-label="Filtrar temas por unidad"
  >
    {
      units.map((unit, index) => (
        <button
          type="button"
          data-unit-button
          data-unit={unit.id}
          aria-pressed={index === 0 ? 'true' : 'false'}
          class="-mb-px border-b-2 border-transparent pb-3 pt-2 text-sm font-semibold text-slate-500 transition hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 aria-pressed:border-emerald-700 aria-pressed:text-emerald-800"
        >
          {unit.label}
        </button>
      ))
    }
  </div>

  <div class="mt-8">
    {
      units.map((unit, index) => (
        <div data-unit-panel={unit.id} hidden={index !== 0}>
          {unit.cards.length > 0 ? (
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {unit.cards.map((card) => (
                <a
                  href={`/${unit.slug}/${card.slug}`}
                  data-card
                  class={`group relative flex h-full flex-col rounded-xl border p-6 pt-7 transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-0.5 hover:shadow-[0_18px_32px_-26px_rgba(16,35,28,0.55)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2 focus-visible:ring-offset-[#fbfcfa] ${accents[card.accent]}`}
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="absolute right-6 top-6 h-4 w-4 text-slate-400 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-ink"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7M8 7h9v9" />
                  </svg>

                  <h3 class="pr-7 text-balance font-display text-[1.9rem] font-bold leading-[1.05] tracking-[-0.025em] text-ink">
                    {card.title}
                  </h3>

                  <p class="mt-4 max-w-[34ch] text-[15px] leading-[1.7] text-slate-600">
                    {card.description}
                  </p>
                </a>
              ))}
            </div>
          ) : (
            <div class="border border-dashed border-slate-300 bg-white/40 px-6 py-16 text-center">
              <p class="font-display text-2xl text-ink">Contenido próximamente</p>
              <p class="mt-2 text-sm text-slate-500">
                Todavía no hay temas en esta unidad.
              </p>
            </div>
          )}
        </div>
      ))
    }
  </div>

  <p class="sr-only" role="status" data-unit-status></p>
</section>

<script>
  const catalog = document.querySelector('[data-catalog]');

  if (catalog) {
    const buttons = [...catalog.querySelectorAll('[data-unit-button]')];
    const panels = [...catalog.querySelectorAll('[data-unit-panel]')];
    const status = catalog.querySelector('[data-unit-status]');

    const setUnit = (unit) => {
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.unit === unit));
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.unitPanel !== unit;
      });

      if (status) {
        const button = buttons.find((item) => item.dataset.unit === unit);
        const panel = panels.find((item) => item.dataset.unitPanel === unit);
        const count = panel ? panel.querySelectorAll('[data-card]').length : 0;
        const label = button ? button.textContent.trim() : `Unidad ${unit}`;

        status.textContent =
          count > 0
            ? `Mostrando ${count} temas de ${label}.`
            : `${label}: contenido próximamente.`;
      }
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => setUnit(button.dataset.unit));
    });

    setUnit('1');
  }
</script>
