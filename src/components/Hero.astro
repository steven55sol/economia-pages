---
---

<section class="relative isolate overflow-hidden border-b border-slate-200 bg-paper">
  <div class="pointer-events-none absolute inset-0 bg-grid" aria-hidden="true"></div>

  <div
    class="relative mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 py-14 sm:px-6 sm:py-16 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-16 lg:py-20"
  >
    <!-- Texto -->
    <div class="min-w-0">
      <h1
        class="font-display text-3xl leading-[1.05] tracking-[-0.03em] whitespace-nowrap text-ink sm:text-4xl lg:text-5xl xl:text-6xl"
      >
        Ingeniería Económica
      </h1>

      <p class="mt-6 max-w-[46ch] text-lg leading-8 text-slate-700">
        Una carrera que combina economía, matemática y finanzas para entender
        cómo se asignan los recursos, modelar problemas reales y evaluar
        decisiones bajo incertidumbre.
      </p>

    </div>

    <!-- Visual -->
    <figure class="mx-auto w-full min-w-0 max-w-xl lg:mx-0 lg:max-w-none">
      <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-2">
        <div>
          <p class="font-display text-lg text-ink">Evaluar alternativas</p>
          <p class="mt-0.5 text-xs text-slate-500">
            Riesgo y retorno de cada opción
          </p>
        </div>

        <div class="flex items-center gap-4 text-xs text-slate-600">
          <span class="flex items-center gap-1.5">
            <span class="h-1.5 w-1.5 rounded-full bg-slate-400" aria-hidden="true"></span>
            Alternativas
          </span>
          <span class="flex items-center gap-1.5">
            <span class="h-[0.3rem] w-5 rounded-full bg-emerald-600" aria-hidden="true"></span>
            Frontera eficiente
          </span>
        </div>
      </div>

      <svg
        viewBox="0 0 600 440"
        class="mt-4 w-full"
        role="img"
        aria-labelledby="career-chart-title career-chart-desc"
      >
        <title id="career-chart-title">
          Evaluación de alternativas por riesgo y retorno
        </title>
        <desc id="career-chart-desc">
          Gráfico de dispersión con varias alternativas de inversión. Una curva
          llamada frontera eficiente atraviesa las opciones con mayor retorno
          para cada nivel de riesgo y destaca una alternativa como la mejor
          opción.
        </desc>

        <defs>
          <linearGradient id="career-area" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#059669" stop-opacity="0.14" />
            <stop offset="100%" stop-color="#059669" stop-opacity="0.02" />
          </linearGradient>
        </defs>

        <!-- Hoja de gráfico con sombra desplazada -->
        <rect x="16" y="24" width="572" height="392" fill="#dbe7dd" />
        <rect x="6" y="14" width="572" height="392" fill="#fbfcfa" stroke="#c9d6cb" />

        <!-- Grilla -->
        <g stroke="#e3ebe4" stroke-width="1">
          <line x1="70" y1="88" x2="520" y2="88" />
          <line x1="70" y1="178" x2="520" y2="178" />
          <line x1="70" y1="269" x2="520" y2="269" />
          <line x1="160" y1="70" x2="160" y2="360" />
          <line x1="250" y1="70" x2="250" y2="360" />
          <line x1="340" y1="70" x2="340" y2="360" />
          <line x1="430" y1="70" x2="430" y2="360" />
        </g>

        <!-- Ejes -->
        <g stroke="#94a3b8" stroke-width="1">
          <line x1="70" y1="70" x2="70" y2="360" />
          <line x1="70" y1="360" x2="520" y2="360" />
        </g>

        <!-- Área de combinaciones posibles -->
        <path
          d="M70 360 Q250 170 520 90 L520 360 Z"
          fill="url(#career-area)"></path>

        <!-- Frontera eficiente -->
        <path
          d="M70 360 Q250 170 520 90"
          fill="none"
          stroke="#059669"
          stroke-width="3"
          stroke-linecap="round"></path>

        <!-- Alternativas debajo de la frontera -->
        <g fill="#94a3b8">
          <circle cx="120" cy="330" r="3.5" />
          <circle cx="160" cy="300" r="3.5" />
          <circle cx="190" cy="340" r="3.5" />
          <circle cx="230" cy="255" r="3.5" />
          <circle cx="260" cy="280" r="3.5" />
          <circle cx="300" cy="215" r="3.5" />
          <circle cx="330" cy="250" r="3.5" />
          <circle cx="370" cy="185" r="3.5" />
          <circle cx="400" cy="215" r="3.5" />
          <circle cx="430" cy="150" r="3.5" />
          <circle cx="455" cy="190" r="3.5" />
          <circle cx="480" cy="140" r="3.5" />
          <circle cx="505" cy="175" r="3.5" />
        </g>

        <!-- Alternativas sobre la frontera -->
        <g fill="#047857" stroke="#fbfcfa" stroke-width="2">
          <circle cx="166" cy="272" r="4" />
          <circle cx="272" cy="198" r="4" />
          <circle cx="467" cy="107" r="4" />
        </g>

        <!-- Mejor opción -->
        <circle
          cx="391"
          cy="137"
          r="11"
          fill="none"
          stroke="#059669"
          stroke-opacity="0.25"></circle>
        <circle
          cx="391"
          cy="137"
          r="5.5"
          fill="#047857"
          stroke="#fbfcfa"
          stroke-width="2"></circle>
        <line
          x1="374"
          y1="127"
          x2="385"
          y2="133"
          stroke="#047857"
          stroke-opacity="0.35"></line>
        <text
          x="370"
          y="124"
          text-anchor="end"
          font-size="13"
          font-weight="600"
          fill="#047857">
          Mejor opción
        </text>

        <!-- Etiquetas de los ejes -->
        <g font-size="12" fill="#94a3b8">
          <text x="70" y="379" text-anchor="start">Menor</text>
          <text x="520" y="379" text-anchor="end">Mayor</text>
          <text x="62" y="360" text-anchor="end">Menor</text>
          <text x="62" y="80" text-anchor="end">Mayor</text>
        </g>

        <!-- Títulos de los ejes -->
        <text x="295" y="403" font-size="15" fill="#475569" text-anchor="middle">
          Riesgo
        </text>
        <text
          x="26"
          y="215"
          font-size="15"
          fill="#475569"
          text-anchor="middle"
          transform="rotate(-90 26 215)">Retorno</text
        >
      </svg>
    </figure>
  </div>
</section>
