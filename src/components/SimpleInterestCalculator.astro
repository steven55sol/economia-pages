    const focalConversionPeriods = root.querySelector('[data-focal-conversion-periods]');
    const focalStaleNotice = root.querySelector('[data-focal-stale]');
    const focalErrorSummary = root.querySelector('[data-focal-error-summary]');
    const focalErrorList = root.querySelector('[data-focal-error-list]');
    const focalErrorElements = {
      rate: root.querySelector('[data-focal-error="rate"]'),
      focalDate: root.querySelector('[data-focal-error="focalDate"]'),
      movements: root.querySelector('[data-focal-error="movements"]'),
      general: root.querySelector('[data-focal-error="general"]'),
    };
    const focalActionStatus = root.querySelector('[data-focal-action-status]');
    const focalResults = root.querySelector('[data-focal-results]');
    const focalResultsTarget = root.querySelector('[data-focal-results-target]');
    const focalResultLabel = root.querySelector('[data-focal-result-label]');
    const focalResultValue = root.querySelector('[data-focal-result-value]');
    const focalResultNote = root.querySelector('[data-focal-result-note]');
    const focalSummaryA = root.querySelector('[data-focal-summary-a]');
    const focalSummaryB = root.querySelector('[data-focal-summary-b]');
    const focalSummaryDiff = root.querySelector('[data-focal-summary-diff]');
    const focalSummaryDate = root.querySelector('[data-focal-summary-date]');
    const focalEquation = root.querySelector('[data-focal-equation]');
    const focalEquationValues = root.querySelector('[data-focal-equation-values]');
    const focalDevelopment = root.querySelector('[data-focal-development]');
    const focalSteps = root.querySelector('[data-focal-steps]');
    const focalMovementTable = root.querySelector('[data-focal-movement-table]');

    const state = {
      target: initialTargetValue(),
      mode: 'normal',
      baseline: null,
      currentSnapshot: null,
      lastResult: null,
      hasCalculated: false,
      charts: null,
      activeChart: 'composition',
      rateType: rateTypeSelect.value,
      focalBaseline: null,
      focalSnapshot: null,
      lastFocalResult: null,
      hasCalculatedFocal: false,
      movementSeq: 0,
      focalRateType: focalRateTypeSelect.value,
    };

    function initialTargetValue() {
      return exercises[0]?.target ?? 'C';
    }

    function getYearDays() {
      const selected = yearDaysInputs.find((input) => input.checked);
      return normalizeYearDays(selected?.value);
    }

    function readFieldValue(fieldName) {
      const field = fields[fieldName];
      if (!field) return '';
      return field.dataset.preciseValue ?? field.value;
    }

    function getFormValues() {
      return {
        target: state.target,
        I: readFieldValue('I'),
        C: readFieldValue('C'),
        M: readFieldValue('M'),
        i: readFieldValue('i'),
        n: readFieldValue('n'),
        timeUnit: timeUnitSelect.value,
        rateType: rateTypeSelect.value,
        yearDays: getYearDays(),
      };
    }

    function setStatus(message) {
      actionStatus.textContent = message;
    }

    function announce(message) {
      liveStatus.textContent = '';
      window.requestAnimationFrame(() => {
        liveStatus.textContent = message;
      });
    }

    const moneyFields = new Set(['I', 'C', 'M']);
    const moneyInputOptions = {
      minimumFractionDigits: 0,
      maximumFractionDigits: 0,
    };
    const rateResultOptions = {
      minimumFractionDigits: 0,
      maximumFractionDigits: 1,
    };
    const timeResultOptions = {
      minimumFractionDigits: 0,
      maximumFractionDigits: 4,
    };
    const rateConversionOptions = {
      minimumFractionDigits: 0,
      maximumFractionDigits: 3,
    };

    function setFieldValue(fieldName, value, options) {
      const field = fields[fieldName];
      if (!field) return;

      if (value === null || value === undefined || value === '') {
        field.value = '';
        delete field.dataset.preciseValue;
        return;
      }

      const parsed = typeof value === 'number' ? value : parseNumber(value);
      if (Number.isFinite(parsed)) {
        field.value = formatInputNumber(
          parsed,
          options ?? (moneyFields.has(fieldName) ? moneyInputOptions : undefined)
        );
        field.dataset.preciseValue = String(parsed).replace('.', ',');
        return;
      }

      field.value = String(value);
      delete field.dataset.preciseValue;
    }

    function setFields(values) {
      setFieldValue('I', values.I);
      setFieldValue('C', values.C);
      setFieldValue('M', values.M);
      setFieldValue('i', values.i);
      setFieldValue('n', values.n);
      timeUnitSelect.value = values.timeUnit ?? 'meses';
      rateTypeSelect.value = values.rateType ?? 'anual';
      state.rateType = rateTypeSelect.value;
      const yearDays = normalizeYearDays(values.yearDays);
      yearDaysInputs.forEach((input) => {
        input.checked = Number(input.value) === yearDays;
      });
    }

    function setTarget(target) {
      state.target = TARGETS[target] ? target : 'I';
      updateTargetUi();
    }

    function updateTargetUi() {
      targetButtons.forEach((button) => {
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.targetOption === state.target)
        );
      });

      Object.entries(targetBoxes).forEach(([key, box]) => {
        box.dataset.target = String(key === state.target);
      });

      Object.entries(targetBadges).forEach(([key, badge]) => {
        badge.hidden = key !== state.target;
      });
    }

    function clearFieldError(fieldName) {
      const errorElement = errorElements[fieldName];
      if (errorElement) {
        errorElement.textContent = '';
        errorElement.hidden = true;
      }

      const input = fields[fieldName];
      if (input) input.removeAttribute('aria-invalid');

      const box = targetBoxes[fieldName];
      if (box) box.dataset.invalid = 'false';
    }

    function clearErrors() {
      Object.keys(errorElements).forEach(clearFieldError);
      errorSummary.hidden = true;
      errorList.replaceChildren();
    }

    function showErrors(errors) {
      clearErrors();
      const messages = [];

      Object.entries(errors).forEach(([fieldName, message]) => {
        const errorElement = errorElements[fieldName];
        if (errorElement) {
          errorElement.textContent = message;
          errorElement.hidden = false;
        }

        const input = fields[fieldName];
        if (input) input.setAttribute('aria-invalid', 'true');

        const box = targetBoxes[fieldName];
        if (box) box.dataset.invalid = 'true';

        messages.push(message);
      });

      if (messages.length === 0) return;

      errorList.replaceChildren(
        ...messages.map((message) => {
          const item = document.createElement('li');
          item.textContent = message;
          return item;
        })
      );
      errorSummary.hidden = false;

      const firstInvalid = Object.keys(errors).find((fieldName) => fields[fieldName]);
      if (firstInvalid) fields[firstInvalid].focus();
    }

    function showStale() {
      if (!state.hasCalculated) return;
      staleNotice.hidden = false;
    }

    function hideStale() {
      staleNotice.hidden = true;
    }

    function convertRateType(nextType) {
      if (!RATE_TYPES[nextType]) return;

      const previousType = state.rateType;
      state.rateType = nextType;
      if (!previousType || previousType === nextType) return;

      const current = parseNumber(readFieldValue('i'));
      if (!Number.isFinite(current) || current <= 0) return;

      const yearDays = getYearDays();
      const annual = toAnnualRate(current, previousType, yearDays);
      const converted = fromAnnualRate(annual, nextType, yearDays);
      setFieldValue('i', converted, rateConversionOptions);
    }

    function updateConversions() {
      const n = parseNumber(readFieldValue('n'));
      const i = parseNumber(readFieldValue('i'));
      const yearDays = getYearDays();
      const timeUnit = timeUnitSelect.value;
      const rateType = rateTypeSelect.value;

      if (Number.isFinite(n) && n > 0) {
        const years = timeToYears(n, timeUnit, yearDays);
        const days = years * yearDays;
        const calendarDays = years * 365;
        const baseText =
          yearDays === 360
            ? `${formatNumber(days, 2)} días comerciales · ${formatNumber(calendarDays, 2)} días calendario`
            : `${formatNumber(days, 2)} días base 365`;

        conversionTime.textContent = `${formatNumber(n, 4)} ${TIME_UNITS[timeUnit].label} = ${formatNumber(years, 4)} años = ${baseText}.`;
      } else {
        conversionTime.textContent = 'Ingresá un tiempo para ver la conversión.';
      }

      if (Number.isFinite(i) && i > 0) {
        const annual = toAnnualRate(i, rateType, yearDays);
        conversionRate.textContent = `${formatPercent(i, state.target === 'i' ? 1 : 2)} ${RATE_TYPES[rateType].label} = ${formatNumber(annual, 6)} anual.`;
      } else {
        conversionRate.textContent = 'Ingresá una tasa para ver la conversión.';
      }
    }

    function renderResult(result) {
      const rateLabel = RATE_TYPES[result.rateType].label;
      const timeLabel = TIME_UNITS[result.timeUnit].label;

      resultsTarget.textContent = result.result.label;
      resultLabel.textContent = result.result.label;
      resultValue.textContent = result.result.formatted;
      resultNote.textContent =
        result.target === 'C'
          ? 'Capital necesario para generar los intereses indicados con esa tasa y ese tiempo.'
          : result.target === 'M'
            ? 'Monto final: capital más los intereses generados durante el tiempo indicado.'
            : result.target === 'I'
              ? 'Interés generado por el capital durante el tiempo indicado.'
              : result.target === 'i'
                ? `Tasa ${rateLabel} equivalente al interés del ejercicio.`
                : 'Tiempo necesario para generar el interés indicado.';

      summaryInterest.textContent = formatMoney(result.summary.interest);
      summaryCapital.textContent = formatMoney(result.summary.capital);
      summaryTotal.textContent = formatMoney(result.summary.total);

      formulaExpression.textContent = result.formula.expression;
      formulaSubstitution.textContent = result.formula.substitution;

      stepsList.replaceChildren(
        ...result.steps.map((step) => {
          const item = document.createElement('li');
          item.textContent = step;
          if (step.startsWith('Resultado:')) {
            item.className = 'font-semibold text-ink';
          }
          return item;
        })
      );

      const dataRows = [
        ['Interés', formatMoney(result.summary.interest)],
        ['Capital inicial', formatMoney(result.summary.capital)],
        ['Monto total', formatMoney(result.summary.total)],
        ['Tasa', `${formatPercent(result.values.i, result.target === 'i' ? 1 : 2)} ${rateLabel}`],
        ['Tiempo', `${formatNumber(result.values.n, 4)} ${timeLabel}`],
        ['Base de días', `${result.yearDays} días`],
        ['Tiempo en años', `${formatNumber(result.conversions.nYears, 4)} años`],
        ['Tiempo en días', `${formatNumber(result.conversions.nDays, 2)} días`],
        ['Tasa anual equivalente', formatPercent(result.conversions.iAnnual * 100, result.target === 'i' ? 1 : 2)],
        ['Tasa anual decimal', formatNumber(result.conversions.iAnnual, 6)],
      ];

      if (result.yearDays === 360) {
        dataRows.push([
          'Equivalencia calendario',
          `${formatNumber(result.conversions.nCalendarDays, 2)} días`,
        ]);
      }

      inputSummary.replaceChildren(
        ...dataRows.map(([term, description]) => {
          const row = document.createElement('div');
          row.className = 'flex items-baseline justify-between gap-3 border-b border-slate-100 pb-1.5';
          const dt = document.createElement('dt');
          dt.className = 'shrink-0 text-slate-500';
          dt.textContent = term;
          const dd = document.createElement('dd');
          dd.className = 'text-right font-medium tabular-nums text-ink';
          dd.textContent = description;
          row.append(dt, dd);
          return row;
        })
      );

      results.hidden = false;
      resultsEmpty.hidden = true;
      hideStale();
    }

    function updateChartEmptyState(showEmpty) {
      root.querySelectorAll('[data-chart-empty]').forEach((element) => {
        element.hidden = !showEmpty;
      });
      root.querySelectorAll('[data-chart-content]').forEach((element) => {
        element.hidden = showEmpty;
      });
    }

    function renderTable(container, headers, rows) {
      container.replaceChildren();
      const table = document.createElement('table');
      table.className = 'w-full text-left text-xs';
      const thead = document.createElement('thead');
      const headRow = document.createElement('tr');
      headers.forEach((header) => {
        const th = document.createElement('th');
        th.className = 'border-b border-slate-200 pb-2 font-semibold text-slate-600';
        th.scope = 'col';
        th.textContent = header;
        headRow.append(th);
      });
      thead.append(headRow);
      const tbody = document.createElement('tbody');
      rows.forEach((row) => {
        const tr = document.createElement('tr');
        row.forEach((cell) => {
          const td = document.createElement('td');
          td.className = 'border-b border-slate-100 py-2 text-slate-600';
          td.textContent = cell;
          tr.append(td);
        });
        tbody.append(tr);
      });
      table.append(thead, tbody);
      container.append(table);
    }

    function renderChartTables(result) {
      const data = buildChartData(result);
      if (!data) return;

      renderTable(
        chartTables.composition,
        ['Concepto', 'Monto'],
        [
          ['Capital inicial', formatMoney(result.summary.capital)],
          ['Interés', formatMoney(result.summary.interest)],
          ['Monto total', formatMoney(result.summary.total)],
        ]
      );

      renderTable(
        chartTables.growth,
        ['Tiempo', 'Interés acumulado'],
        data.growth.labels.map((label, index) => [
          `${label} ${data.growth.unit}`,
          formatMoney(data.growth.values[index]),
        ])
      );

      renderTable(
        chartTables.rates,
        [`Tasa ${RATE_TYPES[result.rateType].label}`, 'Interés'],
        data.rates.labels.map((label, index) => [
          label,
          formatMoney(data.rates.values[index]),
        ])
      );
    }

    function panelIsVisible() {
      const panel = root.closest('[data-tab-panel]');
      return !panel || !panel.hidden;
    }

    function ensureCharts() {
      if (state.mode !== 'normal') return false;
      if (!panelIsVisible()) return false;
      if (state.charts) return true;

      state.charts = createCharts(
        {
          composition: chartCanvases.composition,
          growth: chartCanvases.growth,
          rates: chartCanvases.rates,
        },
        state.lastResult
      );
      renderChartTables(state.lastResult);
      return true;
    }

    function updateChartsIfReady(result) {
      if (!result) return;
      if (state.charts) {
        updateCharts(state.charts, result);
        renderChartTables(result);
        return;
      }

      if (ensureCharts()) {
        updateCharts(state.charts, result);
        renderChartTables(result);
      }
    }

    function calculate({ silent = false } = {}) {
      const result = solveExercise(getFormValues());
      clearErrors();

      if (!result.ok) {
        showErrors(result.errors);
        showStale();
        if (!silent) announce('No se pudo calcular. Revisá los datos.');
        return false;
      }

      state.lastResult = result;
      state.hasCalculated = true;
      updateChartEmptyState(false);
      renderResult(result);

      setFieldValue(
        result.target,
        result.result.value,
        result.target === 'i'
          ? rateResultOptions
          : result.target === 'n'
            ? timeResultOptions
            : undefined
      );

      updateConversions();
      updateChartsIfReady(result);

      if (!silent) {
        setStatus('Resultado actualizado.');
        announce(`${result.result.label}: ${result.result.formatted}`);
      }

      return true;
    }

    function applySnapshot(snapshot, { calculateAfter = true } = {}) {
      if (!snapshot) return;

      state.currentSnapshot = snapshot;
      exerciseHeading.textContent = snapshot.title;
      exerciseStatement.textContent = snapshot.statement;
      exerciseNote.textContent = snapshot.note ?? '';
      exerciseNote.hidden = !snapshot.note;
      syncExerciseSelect(snapshot.presetId);
      setTarget(snapshot.target ?? 'I');
      setFields({
        I: snapshot.values?.I ?? null,
        C: snapshot.values?.C ?? null,
        M: snapshot.values?.M ?? null,
        i: snapshot.values?.i ?? null,
        n: snapshot.values?.n ?? null,
        timeUnit: snapshot.timeUnit ?? 'meses',
        rateType: snapshot.rateType ?? 'anual',
        yearDays: snapshot.yearDays ?? 360,
      });
      clearErrors();
      hideStale();
      setStatus('');

      if (calculateAfter) {
        calculate({ silent: true });
      } else {
        updateConversions();
      }
    }

    function syncExerciseSelect(presetId) {
      if (presetId) exerciseSelect.value = presetId;
    }

    function snapshotFromExercise(exercise) {
      return {
        presetId: exercise.id,
        title: exercise.title,
        statement: exercise.statement,
        note: exercise.note ?? null,
        mode: exercise.mode === 'focal' ? 'focal' : 'normal',
        values: { ...exercise.data },
        target: exercise.target,
        timeUnit: exercise.data?.timeUnit,
        rateType: exercise.data?.rateType,
        yearDays: exercise.yearDays ?? 360,
        focal: exercise.focal ?? null,
      };
    }

    function loadExerciseById(id) {
      const exercise = exercises.find((item) => item.id === id);
      if (!exercise) return;

      const snapshot = snapshotFromExercise(exercise);

      if (snapshot.mode === 'focal') {
        state.focalBaseline = snapshot;
        state.lastFocalResult = null;
        state.hasCalculatedFocal = false;
        setMode('focal');
        applyFocalSnapshot(snapshot);
        return;
      }

      state.baseline = snapshot;
      setMode('normal');
      applySnapshot(snapshot);
      window.requestAnimationFrame(() => resizeCharts(state.charts));
    }

    function resetExercise() {
      if (!state.baseline) return;
      applySnapshot(state.baseline);
      setStatus('Datos restablecidos.');
      announce('Datos restablecidos al ejercicio original.');
    }

    function clearExercise() {
      Object.values(fields).forEach((field) => {
        field.value = '';
        delete field.dataset.preciseValue;
      });
      state.rateType = rateTypeSelect.value;
      state.lastResult = null;
      state.hasCalculated = false;
      clearErrors();
      hideStale();
      updateConversions();
      results.hidden = true;
      if (state.mode === 'normal') resultsEmpty.hidden = false;
      updateChartEmptyState(true);
      setStatus('Formulario limpio.');
      announce('Formulario limpio. Podés completar nuevos datos.');
    }

    // -----------------------------------------------------------------------
    // Fecha focal
    // -----------------------------------------------------------------------

    function setMode(mode) {
      const focal = mode === 'focal';
      state.mode = focal ? 'focal' : 'normal';
      normalPanel.hidden = focal;
      focalPanel.hidden = !focal;
      chartCard.hidden = focal;
      timelineCard.hidden = !focal;

      // En fecha focal la calculadora y la línea de tiempo van una debajo de
      // la otra, a ancho completo, para que la gráfica se vea entera.
      if (calculatorLayout) {
        calculatorLayout.classList.toggle('lg:grid-cols-2', !focal);
      }
      if (calculatorSide) {
        calculatorSide.classList.toggle('lg:sticky', !focal);
        calculatorSide.classList.toggle('lg:top-24', !focal);
      }

      results.hidden = true;
      focalResults.hidden = true;
      resultsEmpty.hidden = focal
        ? Boolean(state.lastFocalResult)
        : Boolean(state.lastResult);
    }

    function getFocalYearDays() {
      const selected = focalYearDaysInputs.find((input) => input.checked);
      return normalizeYearDays(selected?.value);
    }

    function getFocalMovementRows() {
      return [...focalMovementsContainer.querySelectorAll('[data-movement]')];
    }

    function readMovementAmount(row) {
      const input = row.querySelector('[data-movement-amount]');
      return input.dataset.preciseValue ?? input.value;
    }

    function getFocalValues() {
      return {
        rate: focalRateInput.dataset.preciseValue ?? focalRateInput.value,
        rateType: focalRateTypeSelect.value,
        yearDays: getFocalYearDays(),
        focalDate: focalDateInput.value,
        movements: getFocalMovementRows().map((row, index) => ({
          id: row.dataset.movementId ?? `mov-${index}`,
          type: row.querySelector('[data-movement-type]').value,
          date: row.querySelector('[data-movement-date]').value,
          amount: readMovementAmount(row),
          description: row.querySelector('[data-movement-description]').value,
          unknown: row.querySelector('[data-movement-unknown]').checked,
        })),
      };
    }

    function setMovementAmount(row, value) {
      const input = row.querySelector('[data-movement-amount]');
      const parsed = parseNumber(value);

      if (Number.isFinite(parsed) && parsed > 0) {
        input.value = formatInputNumber(parsed, moneyInputOptions);
        input.dataset.preciseValue = String(parsed).replace('.', ',');
      } else {
        input.value = '';
        delete input.dataset.preciseValue;
      }
    }

    function updateFocalUnknownState() {
      getFocalMovementRows().forEach((row) => {
        const unknown = row.querySelector('[data-movement-unknown]').checked;
        const amountInput = row.querySelector('[data-movement-amount]');

        if (unknown) {
          amountInput.value = '';
          delete amountInput.dataset.preciseValue;
        }

        amountInput.disabled = unknown;
      });
    }

    function addMovementRow(movement = {}) {
      state.movementSeq += 1;
      const fragment = movementTemplate.content.cloneNode(true);
      const row = fragment.querySelector('[data-movement]');
      const typeSelect = row.querySelector('[data-movement-type]');
      const dateInput = row.querySelector('[data-movement-date]');
      const descriptionInput = row.querySelector('[data-movement-description]');
      const unknownInput = row.querySelector('[data-movement-unknown]');

      row.dataset.movementId =
        movement.id ?? `mov-${state.movementSeq}`;

      typeSelect.value = MOVEMENT_TYPES[movement.type]
        ? movement.type
        : 'obligacion';
      dateInput.value = movement.date ?? '';
      descriptionInput.value = movement.description ?? '';
      setMovementAmount(row, movement.amount);
      unknownInput.checked = Boolean(movement.unknown);

      focalMovementsContainer.append(row);
      updateFocalUnknownState();
      return row;
    }

    function renderFocalMovements(movements) {
      focalMovementsContainer.replaceChildren();
      const list = Array.isArray(movements) && movements.length > 0
        ? movements
        : [{}];
      list.forEach((movement) => addMovementRow(movement));
    }

    function setFocalStatus(message) {
      focalActionStatus.textContent = message;
    }

    function setFocalFieldValue(value) {
      const parsed = parseNumber(value);
      if (Number.isFinite(parsed)) {
        focalRateInput.value = formatInputNumber(parsed, rateConversionOptions);
        focalRateInput.dataset.preciseValue = String(parsed).replace('.', ',');
      } else {
        focalRateInput.value = '';
        delete focalRateInput.dataset.preciseValue;
      }
    }

    function setFocalFields(focal) {
      const data = focal ?? {};
      setFocalFieldValue(data.rate);
      focalRateTypeSelect.value = RATE_TYPES[data.rateType]
        ? data.rateType
        : 'anual';
      state.focalRateType = focalRateTypeSelect.value;
      focalDateInput.value = data.focalDate ?? '';
      const yearDays = normalizeYearDays(data.yearDays ?? 360);
      focalYearDaysInputs.forEach((input) => {
        input.checked = Number(input.value) === yearDays;
      });
      renderFocalMovements(data.movements);
      clearFocalErrors();
      hideFocalStale();
      setFocalStatus('');
      updateFocalConversions();
      updateFocalLive();
    }

    function clearFocalFieldError(key) {
      const element = focalErrorElements[key];
      if (element) {
        element.textContent = '';
        element.hidden = true;
      }
    }

    function clearFocalErrors() {
      Object.keys(focalErrorElements).forEach(clearFocalFieldError);
      getFocalMovementRows().forEach((row) => {
        const error = row.querySelector('[data-movement-error]');
        if (error) {
          error.textContent = '';
          error.hidden = true;
        }
        row.classList.remove('border-red-300', 'bg-red-50/40');
      });
      focalErrorSummary.hidden = true;
      focalErrorList.replaceChildren();
    }

    function showFocalErrors(errors) {
      clearFocalErrors();
      const messages = [];

      Object.entries(errors).forEach(([key, message]) => {
        if (key.startsWith('movement-')) {
          const index = Number(key.split('-')[1]);
          const row = getFocalMovementRows()[index];
          if (row) {
            const error = row.querySelector('[data-movement-error]');
            if (error) {
              error.textContent = message;
              error.hidden = false;
            }
            row.classList.add('border-red-300', 'bg-red-50/40');
          }
        } else {
          const element = focalErrorElements[key];
          if (element) {
            element.textContent = message;
            element.hidden = false;
          }
        }
        messages.push(message);
      });

      if (messages.length === 0) return;

      focalErrorList.replaceChildren(
        ...messages.map((message) => {
          const item = document.createElement('li');
          item.textContent = message;
          return item;
        })
      );
      focalErrorSummary.hidden = false;
    }

    function showFocalStale() {
      if (!state.hasCalculatedFocal) return;
      focalStaleNotice.hidden = false;
    }

    function hideFocalStale() {
      focalStaleNotice.hidden = true;
    }

    function updateFocalConversions() {
      const rate = parseNumber(focalRateInput.dataset.preciseValue ?? focalRateInput.value);
      const rateType = focalRateTypeSelect.value;
      const yearDays = getFocalYearDays();

      if (Number.isFinite(rate) && rate > 0) {
        const annual = toAnnualRate(rate, rateType, yearDays);
        focalConversionRate.textContent = `${formatPercent(rate, 4)} ${RATE_TYPES[rateType].label} = ${formatNumber(annual, 8)} anual.`;
      } else {
        focalConversionRate.textContent = 'Ingresá una tasa para ver la conversión.';
      }

      focalConversionPeriods.textContent = `Base ${yearDays} días: n = días ÷ ${yearDays} (años).`;
    }

    function updateFocalLive() {
      updateFocalConversions();
      const values = getFocalValues();

      if (!values.focalDate) {
        renderFinancialTimeline(timelineContainer, { ok: false });
        return;
      }

      const result = solveFocalSimple(values);
      if (result.ok) {
        renderFinancialTimeline(timelineContainer, result.timeline);
        return;
      }

      const timeline = buildSimpleTimeline(values);
      renderFinancialTimeline(timelineContainer, timeline);
    }

    function convertFocalRateType(nextType) {
      if (!RATE_TYPES[nextType]) return;

      const previousType = state.focalRateType;
      state.focalRateType = nextType;
      if (!previousType || previousType === nextType) return;

      const current = parseNumber(focalRateInput.dataset.preciseValue ?? focalRateInput.value);
      if (!Number.isFinite(current) || current <= 0) return;

      const yearDays = getFocalYearDays();
      const annual = toAnnualRate(current, previousType, yearDays);
      const converted = fromAnnualRate(annual, nextType, yearDays);
      setFocalFieldValue(converted);
    }

    function renderFocalMovementTable(result) {
      const rows = result.movements.map((movement) => {
        const original = movement.unknown
          ? 'X'
          : formatMoney(movement.amount);
        const periods = formatNumber(Math.abs(movement.years), 6);
        const direction =
          movement.direction === 'futuro'
            ? 'Capitalización'
            : movement.direction === 'pasado'
              ? 'Descuento'
              : 'Sin traslado';

        return [
          MOVEMENT_TYPES[movement.type].label,
          movement.dateLabel,
          original,
          direction,
          `${formatNumber(Math.abs(movement.daysFromFocal), 2)} días = ${periods} años`,
          formatMoney(movement.valueAtFocal),
        ];
      });

      renderTable(
        focalMovementTable,
        ['Tipo', 'Fecha', 'Valor original', 'Traslado', 'Períodos', 'Valor en fecha focal'],
        rows
      );
    }

    function renderFocalResult(result) {
      focalResultsTarget.textContent = result.result.label;
      focalResultLabel.textContent = result.result.label;
      focalResultValue.textContent = result.result.formatted;
      focalResultNote.textContent = result.result.note ?? '';

      focalSummaryA.textContent = formatMoney(result.summary.sideA);
      focalSummaryB.textContent = formatMoney(result.summary.sideB);
      focalSummaryDiff.textContent = formatMoney(result.summary.difference);
      focalSummaryDate.textContent = result.timeline.focalLabel;

      focalEquation.textContent = result.equation;
      focalEquationValues.textContent = result.equationValues;

      focalDevelopment.replaceChildren(
        ...result.development.map((step) => {
          const item = document.createElement('li');
          item.textContent = step;
          return item;
        })
      );

      focalSteps.replaceChildren(
        ...result.steps.map((step) => {
          const item = document.createElement('li');
          item.textContent = step;
          if (step.startsWith('Resultado:')) {
            item.className = 'font-semibold text-ink';
          }
          return item;
        })
      );

      renderFocalMovementTable(result);

      results.hidden = true;
      focalResults.hidden = false;
      resultsEmpty.hidden = true;
      hideFocalStale();
    }

    function calculateFocal({ silent = false } = {}) {
      const values = getFocalValues();
      const result = solveFocalSimple(values);
      clearFocalErrors();

      if (!result.ok) {
        showFocalErrors(result.errors);
        if (state.hasCalculatedFocal) showFocalStale();
        const timeline = buildSimpleTimeline(values);
        renderFinancialTimeline(timelineContainer, timeline);
        if (!silent) announce('No se pudo resolver. Revisá los datos.');
        return false;
      }

      state.lastFocalResult = result;
      state.hasCalculatedFocal = true;
      updateFocalConversions();
      renderFocalResult(result);
      renderFinancialTimeline(timelineContainer, result.timeline);

      if (!silent) {
        setFocalStatus('Resultado actualizado.');
        announce(`${result.result.label}: ${result.result.formatted}`);
      }

      return true;
    }

    function applyFocalSnapshot(snapshot, { calculateAfter = true } = {}) {
      if (!snapshot) return;

      state.focalSnapshot = snapshot;
      exerciseHeading.textContent = snapshot.title;
      exerciseStatement.textContent = snapshot.statement;
      exerciseNote.textContent = snapshot.note ?? '';
      exerciseNote.hidden = !snapshot.note;
      syncExerciseSelect(snapshot.presetId);
      setFocalFields(snapshot.focal);

      if (calculateAfter) {
        calculateFocal({ silent: true });
      } else {
        updateFocalLive();
      }
    }

    function resetFocalExercise() {
      if (!state.focalBaseline) return;
      applyFocalSnapshot(state.focalBaseline);
      setFocalStatus('Datos restablecidos.');
      announce('Datos restablecidos al ejercicio original.');
    }

    function clearFocalExercise() {
      focalRateInput.value = '';
      delete focalRateInput.dataset.preciseValue;
      focalDateInput.value = '';
      focalRateTypeSelect.value = 'anual';
      state.focalRateType = 'anual';
      focalYearDaysInputs.forEach((input) => {
        input.checked = input.value === '360';
      });
      renderFocalMovements([]);
      state.lastFocalResult = null;
      state.hasCalculatedFocal = false;
      clearFocalErrors();
      hideFocalStale();
      updateFocalConversions();
      renderFinancialTimeline(timelineContainer, { ok: false });
      focalResults.hidden = true;
      results.hidden = true;
      resultsEmpty.hidden = false;
      setFocalStatus('Formulario limpio.');
      announce('Formulario limpio. Podés completar nuevos datos.');
    }

    function addEmptyMovement() {
      addMovementRow({
        type: 'obligacion',
        date: focalDateInput.value ?? '',
      });
      updateFocalLive();
      showFocalStale();
    }

    function setChartTab(name) {
      state.activeChart = name;
      chartTabs.forEach((tab) => {
        tab.setAttribute('aria-pressed', String(tab.dataset.chartTab === name));
      });
      chartPanels.forEach((panel) => {
        panel.hidden = panel.dataset.chartPanel !== name;
      });

      ensureCharts();
      window.requestAnimationFrame(() => resizeCharts(state.charts));
    }

    targetButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setTarget(button.dataset.targetOption);
        showStale();
      });
    });

    exerciseSelect.addEventListener('change', () => {
      loadExerciseById(exerciseSelect.value);
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      calculate();
    });

    form.addEventListener('input', (event) => {
      const fieldName = event.target.dataset.field;
      if (!fieldName) return;
      delete event.target.dataset.preciseValue;
      clearFieldError(fieldName);
      updateConversions();
      showStale();
    });

    form.addEventListener('change', (event) => {
      if (event.target.matches('[data-rate-type]')) {
        convertRateType(event.target.value);
        updateConversions();
        showStale();
        return;
      }
      if (event.target.matches('[data-time-unit], [data-year-days]')) {
        updateConversions();
        showStale();
      }
    });

    root.querySelector('[data-action="reset"]').addEventListener('click', resetExercise);
    root.querySelector('[data-action="clear"]').addEventListener('click', clearExercise);

    focalForm.addEventListener('submit', (event) => {
      event.preventDefault();
      calculateFocal();
    });

    focalForm.addEventListener('input', (event) => {
      if (
        event.target.matches('[data-focal-rate], [data-movement-amount]')
      ) {
        delete event.target.dataset.preciseValue;
      }
      if (event.target.matches('[data-focal-rate]')) {
        clearFocalFieldError('rate');
      }
      if (event.target.matches('[data-focal-date]')) {
        clearFocalFieldError('focalDate');
      }
      updateFocalLive();
      showFocalStale();
    });

    focalForm.addEventListener('change', (event) => {
      if (event.target.matches('[data-focal-rate-type]')) {
        convertFocalRateType(event.target.value);
        updateFocalLive();
        showFocalStale();
        return;
      }

      if (event.target.matches('[data-movement-unknown]')) {
        if (event.target.checked) {
          focalMovementsContainer
            .querySelectorAll('[data-movement-unknown]')
            .forEach((checkbox) => {
              if (checkbox !== event.target) checkbox.checked = false;
            });
        }
        updateFocalUnknownState();
      }

      updateFocalLive();
      showFocalStale();
    });

    focalMovementsContainer.addEventListener('click', (event) => {
      const removeButton = event.target.closest('[data-remove-movement]');
      if (!removeButton) return;

      const row = removeButton.closest('[data-movement]');
      if (row) row.remove();
      if (getFocalMovementRows().length === 0) addMovementRow({});
      updateFocalLive();
      showFocalStale();
    });

    addMovementButton.addEventListener('click', addEmptyMovement);

    root
      .querySelector('[data-focal-action="reset"]')
      .addEventListener('click', resetFocalExercise);
    root
      .querySelector('[data-focal-action="clear"]')
      .addEventListener('click', clearFocalExercise);

    chartTabs.forEach((tab) => {
      tab.addEventListener('click', () => setChartTab(tab.dataset.chartTab));
    });

    document.addEventListener('topic-tab-change', (event) => {
      if (event.detail?.tab !== 'ejercicios') return;
      window.requestAnimationFrame(() => {
        ensureCharts();
        resizeCharts(state.charts);
      });
    });

    const initialSnapshot = initialExercise
      ? snapshotFromExercise(initialExercise)
      : null;

    setMode('normal');

    if (initialSnapshot) {
      state.baseline = initialSnapshot;
      applySnapshot(initialSnapshot);
      setChartTab('composition');
    } else {
      updateChartEmptyState(true);
      updateConversions();
    }
  }
</script>
