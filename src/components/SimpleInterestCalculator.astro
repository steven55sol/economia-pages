    const timelineCard = root.querySelector('[data-timeline-card]');
    const timelineContainer = root.querySelector('[data-timeline]');
    const focalForm = root.querySelector('[data-focal-form]');
    const focalRateInput = root.querySelector('[data-focal-rate]');
    const focalRateTypeSelect = root.querySelector('[data-focal-rate-type]');
    const focalDateInput = root.querySelector('[data-focal-date]');
    const focalYearDaysInputs = [
      ...root.querySelectorAll('[data-focal-year-days]'),
    ];
    const focalMovementsContainer = root.querySelector('[data-focal-movements]');
    const movementTemplate = root.querySelector('[data-movement-template]');
    const addMovementButton = root.querySelector('[data-add-movement]');
