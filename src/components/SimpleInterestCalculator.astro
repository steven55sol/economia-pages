---
import {simpleInterestExercises,} from '../data/exercises.js';
import {
  formatInputNumber,
  parseNumber,
  MOVEMENT_TYPES,
} from '../scripts/simple-interest.js';

const exercises = simpleInterestExercises;
const initialExercise = exercises[0];
const initialTarget = initialExercise?.target ?? 'C';
const initialYearDays = initialExercise?.yearDays ?? 360;
const initialValues = initialExercise?.data ?? {};
const movementTypes = Object.entries(MOVEMENT_TYPES);

const inputBoxClass =
  'mt-2 flex items-center overflow-hidden rounded-lg border border-slate-300 bg-white transition focus-within:border-emerald-600 focus-within:ring-2 focus-within:ring-emerald-600/20 data-[invalid=true]:border-red-400 data-[invalid=true]:ring-2 data-[invalid=true]:ring-red-100 data-[target=true]:border-ochre data-[target=true]:bg-[#fdf9f0]';
const inputClass =
  'w-full border-0 bg-transparent px-3 py-2.5 text-sm tabular-nums text-ink outline-none placeholder:text-slate-400';
const selectClass =
  'w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-ink outline-none transition focus:border-emerald-600 focus:ring-2 focus:ring-emerald-600/20';
const fieldLabelClass = 'text-sm font-medium text-slate-700';
const targetButtonClass =
  'rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-600 transition hover:border-slate-300 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2 aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-white';
const chartTabClass =
  'rounded-md px-2 py-1.5 text-xs font-semibold text-slate-500 transition hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2 aria-pressed:bg-white aria-pressed:text-ink aria-pressed:shadow-sm sm:px-3';
const secondaryButtonClass =
  'rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600 transition hover:border-slate-300 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2';

const moneyInputOptions = {
  minimumFractionDigits: 0,
  maximumFractionDigits: 0,
};

const fieldValue = (value, options) => {
  const parsed = parseNumber(value);
  return Number.isFinite(parsed) ? formatInputNumber(parsed, options) : '';
};
---

<section data-simple-interest-calculator class="text-slate-900">
  <header
    class="flex flex-col gap-5 border-b border-slate-200 pb-8 sm:flex-row sm:items-end sm:justify-between"
  >
    <div>
      <p class="flex items-center gap-2.5 text-sm font-semibold text-slate-700">
        <span class="h-px w-6 bg-ochre" aria-hidden="true"></span>
        Ejercicios
      </p>
      <h2
        data-exercise-heading
        class="mt-3 font-display text-3xl tracking-[-0.01em] text-ink sm:text-4xl"
      >
        {initialExercise?.title ?? 'Ejercicios'}
      </h2>
    </div>

    <label class="flex w-full flex-col gap-2 text-sm text-slate-600 sm:w-auto sm:flex-row sm:items-center sm:gap-3">
      <span class="whitespace-nowrap">Cambiar ejercicio</span>
      <span class="relative block w-full sm:w-auto">
        <select
          data-exercise-select
          class="w-full appearance-none rounded-lg border border-slate-300 bg-white py-2.5 pr-9 pl-3 text-sm font-medium text-ink outline-none transition focus:border-emerald-600 focus:ring-2 focus:ring-emerald-600/20 sm:min-w-44"
        >
          {exercises.map((exercise) => (
            <option value={exercise.id} selected={exercise.id === initialExercise?.id}>
              {exercise.title}
            </option>
          ))}
        </select>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="pointer-events-none absolute top-1/2 right-3 h-4 w-4 -translate-y-1/2 text-slate-400"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </span>
    </label>
  </header>

  <div
    class="mt-6 rounded-2xl border border-[#e7dcc6] bg-[#fdf9f0] px-6 py-6 sm:px-8"
  >
    <p class="text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">
      Enunciado
    </p>
    <p
      data-exercise-statement
      class="mt-3 max-w-4xl font-display text-xl leading-8 text-ink sm:text-2xl sm:leading-9"
    >
      {initialExercise?.statement}
    </p>
    <p
      data-exercise-note
      class="mt-3 max-w-3xl text-sm leading-6 text-slate-600"
      hidden={!initialExercise?.note}
    >
      {initialExercise?.note ?? ''}
    </p>
  </div>

  <div data-calculator-layout class="mt-8 grid items-start gap-8 lg:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white">
      <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
        <h3 class="font-display text-2xl text-ink">Calculadora</h3>
        <p class="mt-1 text-sm text-slate-500">
          Completá los datos y presioná Calcular.
        </p>
      </div>

      <form data-calculator-form data-normal-panel class="px-5 py-6 sm:px-6" novalidate>
        <fieldset>
          <legend class="text-sm font-semibold text-slate-900">
            ¿Qué querés calcular?
          </legend>
          <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-5" role="group" aria-label="Variable a calcular">
            <button
              type="button"
              data-target-option="I"
              aria-pressed={initialTarget === 'I' ? 'true' : 'false'}
              class={targetButtonClass}
            >
              Interés
            </button>
            <button
              type="button"
              data-target-option="C"
              aria-pressed={initialTarget === 'C' ? 'true' : 'false'}
              class={targetButtonClass}
            >
              Capital
            </button>
            <button
              type="button"
              data-target-option="M"
              aria-pressed={initialTarget === 'M' ? 'true' : 'false'}
              class={targetButtonClass}
            >
              Monto
            </button>
            <button
              type="button"
              data-target-option="i"
              aria-pressed={initialTarget === 'i' ? 'true' : 'false'}
              class={targetButtonClass}
            >
              Tasa
            </button>
            <button
              type="button"
              data-target-option="n"
              aria-pressed={initialTarget === 'n' ? 'true' : 'false'}
              class={targetButtonClass}
            >
              Tiempo
            </button>
          </div>
        </fieldset>

        <p class="mt-3 text-xs leading-5 text-slate-500">
          El campo marcado con «se calcula» se actualiza al presionar Calcular.
          Todos los campos se pueden editar.
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div>
            <div class="flex items-center justify-between gap-2">
              <label for="si-I" class={fieldLabelClass}>Interés (I)</label>
              <span data-target-badge="I" hidden={initialTarget !== 'I'} class="text-xs font-semibold text-ochre">
                Se calcula
              </span>
            </div>
            <div
              data-target-box="I"
              data-target={initialTarget === 'I' ? 'true' : 'false'}
              class={inputBoxClass}
            >
              <span class="pl-3 text-sm text-slate-500" aria-hidden="true">US$</span>
              <input
                id="si-I"
                data-field="I"
                value={fieldValue(initialValues.I, moneyInputOptions)}
                type="text"
                inputmode="decimal"
                autocomplete="off"
                placeholder="0"
                aria-describedby="si-error-I"
                class={inputClass}
              />
            </div>
            <p id="si-error-I" data-error="I" class="mt-1.5 hidden text-xs text-red-600"></p>
          </div>

          <div>
            <div class="flex items-center justify-between gap-2">
              <label for="si-C" class={fieldLabelClass}>Capital (C)</label>
              <span data-target-badge="C" hidden={initialTarget !== 'C'} class="text-xs font-semibold text-ochre">
                Se calcula
              </span>
            </div>
            <div
              data-target-box="C"
              data-target={initialTarget === 'C' ? 'true' : 'false'}
              class={inputBoxClass}
            >
              <span class="pl-3 text-sm text-slate-500" aria-hidden="true">US$</span>
              <input
                id="si-C"
                data-field="C"
                value={fieldValue(initialValues.C, moneyInputOptions)}
                type="text"
                inputmode="decimal"
                autocomplete="off"
                placeholder="0"
                aria-describedby="si-error-C"
                class={inputClass}
              />
            </div>
            <p id="si-error-C" data-error="C" class="mt-1.5 hidden text-xs text-red-600"></p>
          </div>

          <div>
            <div class="flex items-center justify-between gap-2">
              <label for="si-M" class={fieldLabelClass}>Monto final (M)</label>
              <span data-target-badge="M" hidden={initialTarget !== 'M'} class="text-xs font-semibold text-ochre">
                Se calcula
              </span>
            </div>
            <div
              data-target-box="M"
              data-target={initialTarget === 'M' ? 'true' : 'false'}
              class={inputBoxClass}
            >
              <span class="pl-3 text-sm text-slate-500" aria-hidden="true">US$</span>
              <input
                id="si-M"
                data-field="M"
                value={fieldValue(initialValues.M, moneyInputOptions)}
                type="text"
                inputmode="decimal"
                autocomplete="off"
                placeholder="0"
                aria-describedby="si-error-M"
                class={inputClass}
              />
            </div>
            <p id="si-error-M" data-error="M" class="mt-1.5 hidden text-xs text-red-600"></p>
          </div>

          <div>
            <div class="flex items-center justify-between gap-2">
              <label for="si-i" class={fieldLabelClass}>Tasa (i)</label>
              <span data-target-badge="i" hidden={initialTarget !== 'i'} class="text-xs font-semibold text-ochre">
                Se calcula
              </span>
            </div>
            <div
              data-target-box="i"
              data-target={initialTarget === 'i' ? 'true' : 'false'}
              class={inputBoxClass}
            >
              <input
                id="si-i"
                data-field="i"
                value={fieldValue(initialValues.i)}
                type="text"
                inputmode="decimal"
                autocomplete="off"
                placeholder="0"
                aria-describedby="si-error-i"
                class={inputClass}
              />
              <span class="pr-3 text-sm text-slate-500" aria-hidden="true">%</span>
            </div>
            <p id="si-error-i" data-error="i" class="mt-1.5 hidden text-xs text-red-600"></p>
          </div>

          <div>
            <label for="si-rate-type" class={fieldLabelClass}>Tipo de tasa</label>
            <select id="si-rate-type" data-rate-type class={`${selectClass} mt-2`}>
              <option value="anual" selected={initialValues.rateType === 'anual'}>Anual</option>
              <option value="mensual" selected={initialValues.rateType === 'mensual'}>Mensual</option>
              <option value="semanal" selected={initialValues.rateType === 'semanal'}>Semanal</option>
            </select>
          </div>

          <div>
            <div class="flex items-center justify-between gap-2">
              <label for="si-n" class={fieldLabelClass}>Tiempo (n)</label>
              <span data-target-badge="n" hidden={initialTarget !== 'n'} class="text-xs font-semibold text-ochre">
                Se calcula
              </span>
            </div>
            <div class="mt-2 flex gap-2">
              <div
                data-target-box="n"
                data-target={initialTarget === 'n' ? 'true' : 'false'}
                class={`${inputBoxClass} mt-0 flex-1`}
              >
                <input
                  id="si-n"
                  data-field="n"
                  value={fieldValue(initialValues.n)}
                  type="text"
                  inputmode="decimal"
                  autocomplete="off"
                  placeholder="0"
                  aria-describedby="si-error-n"
                  class={inputClass}
                />
              </div>
              <select
                data-time-unit
                aria-label="Unidad de tiempo"
                class="w-28 rounded-lg border border-slate-300 bg-white px-2 py-2.5 text-sm text-ink outline-none transition focus:border-emerald-600 focus:ring-2 focus:ring-emerald-600/20"
              >
                <option value="dias" selected={initialValues.timeUnit === 'dias'}>Días</option>
                <option value="meses" selected={initialValues.timeUnit === 'meses'}>Meses</option>
                <option value="anios" selected={initialValues.timeUnit === 'anios'}>Años</option>
              </select>
            </div>
            <p id="si-error-n" data-error="n" class="mt-1.5 hidden text-xs text-red-600"></p>
          </div>

          <fieldset>
            <legend class={fieldLabelClass}>Base de días</legend>
            <div class="mt-2 grid grid-cols-2 gap-2">
              <label class="cursor-pointer">
                <input
                  type="radio"
                  name="si-year-days"
                  value="360"
                  data-year-days
                  checked={initialYearDays === 360}
                  class="peer sr-only"
                />
                <span class="block rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-center text-xs font-semibold text-slate-600 transition peer-checked:border-ink peer-checked:bg-ink peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-600 peer-focus-visible:ring-offset-2">
                  360 comercial
                </span>
              </label>
              <label class="cursor-pointer">
                <input
                  type="radio"
                  name="si-year-days"
                  value="365"
                  data-year-days
                  checked={initialYearDays === 365}
                  class="peer sr-only"
                />
                <span class="block rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-center text-xs font-semibold text-slate-600 transition peer-checked:border-ink peer-checked:bg-ink peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-600 peer-focus-visible:ring-offset-2">
                  365 calendario
                </span>
              </label>
            </div>
          </fieldset>
        </div>

        <div class="mt-6 rounded-xl border border-slate-200 bg-slate-50 px-4 py-4">
          <p class="text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">
            Conversión automática
          </p>
          <dl class="mt-3 space-y-2 text-sm">
            <div class="flex gap-2">
              <dt class="w-14 shrink-0 text-slate-500">Tiempo</dt>
              <dd data-conversion-time class="text-slate-700">—</dd>
            </div>
            <div class="flex gap-2">
              <dt class="w-14 shrink-0 text-slate-500">Tasa</dt>
              <dd data-conversion-rate class="text-slate-700">—</dd>
            </div>
          </dl>
        </div>

        <p
          data-stale
          hidden
          class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-900"
        >
          Los datos cambiaron. Presioná Calcular para actualizar los resultados.
        </p>

        <div
          data-error-summary
          hidden
          role="alert"
          class="mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
        >
          <p class="font-semibold">Revisá los datos:</p>
          <ul data-error-list class="mt-1 list-inside list-disc"></ul>
        </div>

        <div class="mt-6 grid gap-2">
          <button
            type="submit"
            class="inline-flex w-full items-center justify-center rounded-lg bg-emerald-700 px-4 py-3 text-sm font-semibold text-white transition hover:bg-emerald-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2"
          >
            Calcular
          </button>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" data-action="reset" class={secondaryButtonClass}>
              Restablecer
            </button>
            <button type="button" data-action="clear" class={secondaryButtonClass}>
              Limpiar
            </button>
          </div>
          <p data-action-status role="status" aria-live="polite" class="min-h-5 text-xs text-slate-500"></p>
        </div>
      </form>

      <form data-focal-form data-focal-panel hidden class="px-5 py-6 sm:px-6" novalidate>
        <fieldset>
          <legend class="text-sm font-semibold text-slate-900">
            Ecuación de valor con fecha focal
          </legend>
          <p class="mt-1 text-xs leading-5 text-slate-500">
            Cada cantidad se traslada a la fecha focal con interés simple: se capitaliza si está antes y se descuenta si está después.
          </p>

          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div>
              <label for="sf-rate" class={fieldLabelClass}>Tasa (i)</label>
              <div class={`${inputBoxClass} mt-2`}>
                <input
                  id="sf-rate"
                  data-focal-rate
                  type="text"
                  inputmode="decimal"
                  autocomplete="off"
                  placeholder="0"
                  aria-describedby="sf-error-rate"
                  class={inputClass}
                />
                <span class="pr-3 text-sm text-slate-500" aria-hidden="true">%</span>
              </div>
              <p id="sf-error-rate" data-focal-error="rate" class="mt-1.5 hidden text-xs text-red-600"></p>
            </div>

            <div>
              <label for="sf-rate-type" class={fieldLabelClass}>Tipo de tasa</label>
              <select id="sf-rate-type" data-focal-rate-type class={`${selectClass} mt-2`}>
                <option value="anual">Anual</option>
                <option value="mensual">Mensual</option>
                <option value="semanal">Semanal</option>
              </select>
            </div>

            <div>
              <label for="sf-focal-date" class={fieldLabelClass}>Fecha focal</label>
              <input
                id="sf-focal-date"
                data-focal-date
                type="date"
                aria-describedby="sf-error-focal-date"
                class={`${selectClass} mt-2`}
              />
              <p id="sf-error-focal-date" data-focal-error="focalDate" class="mt-1.5 hidden text-xs text-red-600"></p>
            </div>

            <fieldset>
              <legend class={fieldLabelClass}>Base de días</legend>
              <div class="mt-2 grid grid-cols-2 gap-2">
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="sf-year-days"
                    value="360"
                    data-focal-year-days
                    checked
                    class="peer sr-only"
                  />
                  <span class="block rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-center text-xs font-semibold text-slate-600 transition peer-checked:border-ink peer-checked:bg-ink peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-600 peer-focus-visible:ring-offset-2">
                    360 comercial
                  </span>
                </label>
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="sf-year-days"
                    value="365"
                    data-focal-year-days
                    class="peer sr-only"
                  />
                  <span class="block rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-center text-xs font-semibold text-slate-600 transition peer-checked:border-ink peer-checked:bg-ink peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-600 peer-focus-visible:ring-offset-2">
                    365 calendario
                  </span>
                </label>
              </div>
            </fieldset>
          </div>
        </fieldset>

        <div class="mt-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h4 class="text-sm font-semibold text-slate-900">Movimientos</h4>
              <p class="mt-1 text-xs text-slate-500">
                Agregá obligaciones, pagos, inversiones o recepciones. Marcá una sola incógnita.
              </p>
            </div>
            <button type="button" data-add-movement class={secondaryButtonClass}>
              + Agregar movimiento
            </button>
          </div>
          <div data-focal-movements class="mt-3 grid gap-3 lg:grid-cols-2"></div>
          <p data-focal-error="movements" class="mt-1.5 hidden text-xs text-red-600"></p>
        </div>

        <div class="mt-6 rounded-xl border border-slate-200 bg-slate-50 px-4 py-4">
          <p class="text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">
            Conversión automática
          </p>
          <dl class="mt-3 space-y-2 text-sm">
            <div class="flex gap-2">
              <dt class="w-16 shrink-0 text-slate-500">Tasa</dt>
              <dd data-focal-conversion-rate class="text-slate-700">—</dd>
            </div>
            <div class="flex gap-2">
              <dt class="w-16 shrink-0 text-slate-500">Períodos</dt>
              <dd data-focal-conversion-periods class="text-slate-700">—</dd>
            </div>
          </dl>
        </div>

        <p
          data-focal-error="general"
          class="mt-4 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
        ></p>

        <p
          data-focal-stale
          hidden
          class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-900"
        >
          Los datos cambiaron. Presioná Calcular para actualizar la resolución.
        </p>

        <div
          data-focal-error-summary
          hidden
          role="alert"
          class="mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
        >
          <p class="font-semibold">Revisá los datos:</p>
          <ul data-focal-error-list class="mt-1 list-inside list-disc"></ul>
        </div>

        <div class="mt-6 grid gap-2">
          <button
            type="submit"
            class="inline-flex w-full items-center justify-center rounded-lg bg-emerald-700 px-4 py-3 text-sm font-semibold text-white transition hover:bg-emerald-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2"
          >
            Calcular
          </button>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" data-focal-action="reset" class={secondaryButtonClass}>
              Restablecer
            </button>
            <button type="button" data-focal-action="clear" class={secondaryButtonClass}>
              Limpiar
            </button>
          </div>
          <p data-focal-action-status role="status" aria-live="polite" class="min-h-5 text-xs text-slate-500"></p>
        </div>
      </form>

      <template data-movement-template>
        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3" data-movement>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="flex items-center justify-between gap-2 sm:col-span-2">
              <span class="text-[11px] font-semibold tracking-[0.12em] text-slate-500 uppercase">
                Movimiento
              </span>
              <button
                type="button"
                data-remove-movement
                class="text-xs font-semibold text-red-600 transition hover:text-red-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
              >
                Eliminar
              </button>
            </div>

            <label class="text-xs font-medium text-slate-600">
              Tipo
              <select data-movement-type class={`${selectClass} mt-1`}>
                {movementTypes.map(([value, config]) => (
                  <option value={value}>{config.label}</option>
                ))}
              </select>
            </label>

            <label class="text-xs font-medium text-slate-600">
              Fecha
              <input
                type="date"
                data-movement-date
                class={`${selectClass} mt-1`}
              />
            </label>

            <label class="text-xs font-medium text-slate-600">
              Valor
