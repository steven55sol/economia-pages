---
import { units } from '../data/catalog.js';

const unit = units[0];
const topics = unit.cards.map((card) => ({
  label: card.title,
  href: `/${unit.slug}/${card.slug}`,
}));
---

<header
  data-header
  class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/85 backdrop-blur-md"
>
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-4">
      <!-- Logo + nombre -->
      <a
        href="/"
        aria-label="Economía App, ir al inicio"
        class="group flex items-center gap-2.5 rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2"
      >
        <span
          class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white shadow-sm shadow-emerald-600/20 transition-transform duration-200 group-hover:scale-105"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-5 w-5"
            aria-hidden="true"
          >
            <path d="M4 19V5" />
            <path d="M4 19h16" />
            <path d="m7 15 3-4 3 2 4-6" />
          </svg>
        </span>

        <span class="flex items-baseline gap-1.5">
          <span class="text-lg font-bold tracking-tight text-slate-900">Economía</span>
          <span
            class="rounded-md bg-emerald-50 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-widest text-emerald-700"
          >
            App
          </span>
        </span>
      </a>

      <!-- Botón hamburguesa (siempre visible) -->
      <button
        data-menu-button
        type="button"
        aria-expanded="false"
        aria-controls="main-menu"
        aria-label="Abrir menú"
        class="grid h-10 w-10 place-items-center rounded-xl border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2"
      >
        <svg
          data-icon-open
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg
          data-icon-close
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="hidden h-5 w-5"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>

    <!-- Panel del menú -->
    <div
      id="main-menu"
      data-menu
      aria-hidden="true"
      class="pointer-events-none invisible absolute left-4 right-4 top-full z-50 -translate-y-2 rounded-2xl border border-slate-200 bg-white p-2 opacity-0 shadow-xl shadow-slate-900/10 ring-1 ring-slate-900/5 transition-all duration-200 ease-out sm:left-6 sm:right-6 lg:left-auto lg:right-8 lg:w-80"
    >
      <nav aria-label="Navegación principal">
        <div>
          <button
            data-accordion-button
            type="button"
            aria-expanded="false"
            aria-controls="unidad-1-panel"
            class="flex w-full items-center justify-between gap-3 rounded-xl px-3 py-2.5 text-left text-sm font-semibold text-slate-800 transition hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
          >
            <span class="flex items-center gap-2.5">
              <span
                class="grid h-6 w-6 place-items-center rounded-md bg-emerald-100 text-xs font-bold text-emerald-700"
              >
                1
              </span>
              Unidad 1
            </span>

            <svg
              data-chevron
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4 shrink-0 text-slate-400 transition-transform duration-300"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </button>

          <div
            id="unidad-1-panel"
            data-accordion-panel
            class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out"
            inert
          >
            <div class="overflow-hidden">
              <ul class="ml-6 mt-1 space-y-1 border-l border-slate-200 pb-1 pl-3">
                {
                  topics.map((topic) => (
                    <li>
                      <a
                        href={topic.href}
                        class="group flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-600 transition hover:bg-emerald-50 hover:text-emerald-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
                      >
                        <span class="h-1.5 w-1.5 rounded-full bg-slate-300 transition group-hover:bg-emerald-500" />
                        {topic.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]');

  if (header) {
    const menuButton = header.querySelector('[data-menu-button]');
    const menu = header.querySelector('[data-menu]');
    const iconOpen = header.querySelector('[data-icon-open]');
    const iconClose = header.querySelector('[data-icon-close]');
    const accordionButton = header.querySelector('[data-accordion-button]');
    const accordionPanel = header.querySelector('[data-accordion-panel]');
    const chevron = header.querySelector('[data-chevron]');

    const setMenu = (open) => {
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      menu.setAttribute('aria-hidden', String(!open));

      menu.classList.toggle('visible', open);
      menu.classList.toggle('opacity-100', open);
      menu.classList.toggle('translate-y-0', open);
      menu.classList.toggle('pointer-events-auto', open);

      menu.classList.toggle('invisible', !open);
      menu.classList.toggle('opacity-0', !open);
      menu.classList.toggle('-translate-y-2', !open);
      menu.classList.toggle('pointer-events-none', !open);

      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
    };

    const setAccordion = (open) => {
      accordionButton.setAttribute('aria-expanded', String(open));
      accordionPanel.classList.toggle('grid-rows-[1fr]', open);
      accordionPanel.classList.toggle('grid-rows-[0fr]', !open);
      accordionPanel.toggleAttribute('inert', !open);
      chevron.classList.toggle('rotate-180', open);
    };

    menuButton.addEventListener('click', () => {
      setMenu(menuButton.getAttribute('aria-expanded') !== 'true');
    });

    accordionButton.addEventListener('click', () => {
      setAccordion(accordionButton.getAttribute('aria-expanded') !== 'true');
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenu(false));
    });

    document.addEventListener('click', (event) => {
      if (!header.contains(event.target) && menuButton.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        menuButton.focus();
      }
    });
  }
</script>
