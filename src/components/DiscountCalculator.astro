---
import { discountExercises } from '../data/discount-exercises.js';
import {
  CRITERIA,
  RATE_TYPES,
  TIME_UNITS,
  formatInputNumber,
  parseNumber,
} from '../scripts/discount.js';

const exercises = discountExercises;
const initialExercise = exercises[0];
const initialTarget = initialExercise?.target ?? 'D';
const initialCriterion = initialExercise?.criterion ?? 'comercial';
const initialYearDays = initialExercise?.yearDays ?? 360;
const initialValues = initialExercise?.data ?? {};
const rateTypeOptions = Object.entries(RATE_TYPES);
const timeUnitOptions = Object.entries(TIME_UNITS);
const criterionOptions = Object.entries(CRITERIA);

const initialRateLabel = CRITERIA[initialCriterion].rateLabel;
const initialRateSymbol = CRITERIA[initialCriterion].rateSymbol;
const initialEffectiveLabel =
  initialCriterion === 'comercial' ? 'Valor efectivo' : 'Valor actual';

const inputBoxClass =
  'mt-2 flex items-center overflow-hidden rounded-lg border border-slate-300 bg-white transition focus-within:border-sky-600 focus-within:ring-2 focus-within:ring-sky-600/20 data-[invalid=true]:border-red-400 data-[invalid=true]:ring-2 data-[invalid=true]:ring-red-100 data-[target=true]:border-sky-600 data-[target=true]:bg-sky-50';
const inputClass =
  'w-full border-0 bg-transparent px-3 py-2.5 text-sm tabular-nums text-ink outline-none placeholder:text-slate-400';
const selectClass =
  'w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-ink outline-none transition focus:border-sky-600 focus:ring-2 focus:ring-sky-600/20';
const fieldLabelClass = 'text-sm font-medium text-slate-700';
const targetButtonClass =
  'rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-600 transition hover:border-slate-300 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 aria-pressed:border-sky-700 aria-pressed:bg-sky-700 aria-pressed:text-white';
const criterionButtonClass =
  'rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-600 transition hover:border-slate-300 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 aria-pressed:border-sky-700 aria-pressed:bg-sky-700 aria-pressed:text-white';
const chartTabClass =
  'rounded-md px-2 py-1.5 text-xs font-semibold text-slate-500 transition hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 aria-pressed:bg-white aria-pressed:text-ink aria-pressed:shadow-sm sm:px-3';
const secondaryButtonClass =
  'rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600 transition hover:border-slate-300 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2';

const moneyInputOptions = {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
};

const fieldValue = (value, options) => {
  const parsed = parseNumber(value);
  return Number.isFinite(parsed) ? formatInputNumber(parsed, options) : '';
};
---

<section data-discount-calculator class="text-slate-900">
  <header class="flex flex-col gap-5 border-b border-slate-200 pb-8 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="flex items-center gap-2.5 text-sm font-semibold text-slate-700">
        <span class="h-px w-6 bg-sky-600" aria-hidden="true"></span>
        Ejercicios · Descuento simple
      </p>
      <h2 data-exercise-heading class="mt-3 font-display text-3xl tracking-[-0.01em] text-ink sm:text-4xl">
        {initialExercise?.title ?? 'Descuento simple'}
      </h2>
    </div>

    <label class="flex w-full flex-col gap-2 text-sm text-slate-600 sm:w-auto sm:flex-row sm:items-center sm:gap-3">
      <span class="whitespace-nowrap">Cambiar ejercicio</span>
      <span class="relative block w-full sm:w-auto">
        <select
          data-exercise-select
          class="w-full appearance-none rounded-lg border border-slate-300 bg-white py-2.5 pr-9 pl-3 text-sm font-medium text-ink outline-none transition focus:border-sky-600 focus:ring-2 focus:ring-sky-600/20 sm:min-w-44"
        >
          {exercises.map((exercise) => (
            <option value={exercise.id} selected={exercise.id === initialExercise?.id}>
              {exercise.title}
            </option>
          ))}
        </select>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="pointer-events-none absolute top-1/2 right-3 h-4 w-4 -translate-y-1/2 text-slate-400"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </span>
    </label>
  </header>

  <div class="mt-6 rounded-2xl border border-[#d5e4ee] bg-[#f4f9fc] px-6 py-6 sm:px-8">
    <p class="text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">
      Enunciado
    </p>
    <p data-exercise-statement class="mt-3 max-w-4xl font-display text-xl leading-8 text-ink sm:text-2xl sm:leading-9">
      {initialExercise?.statement}
    </p>
    <p data-exercise-note class="mt-3 max-w-3xl text-sm leading-6 text-slate-600" hidden={!initialExercise?.note}>
      {initialExercise?.note ?? ''}
    </p>
  </div>

  <div class="mt-8 grid items-start gap-8 lg:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white">
      <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
        <h3 class="font-display text-2xl text-ink">Calculadora</h3>
        <p class="mt-1 text-sm text-slate-500">
          Elegí el criterio, completá los datos y presioná Calcular.
        </p>
      </div>

      <form data-calculator-form class="px-5 py-6 sm:px-6" novalidate>
        <fieldset>
          <legend class="text-sm font-semibold text-slate-900">
            Criterio de descuento
          </legend>
          <div class="mt-3 grid grid-cols-2 gap-2" role="group" aria-label="Criterio de descuento">
            {criterionOptions.map(([value, config]) => (
              <button
                type="button"
                data-criterion-option={value}
                aria-pressed={initialCriterion === value ? 'true' : 'false'}
                class={criterionButtonClass}
              >
                {config.label}
              </button>
            ))}
          </div>
          <p data-criterion-help class="mt-2 text-xs leading-5 text-slate-500">
            {initialCriterion === 'comercial'
              ? 'Comercial: el descuento se calcula sobre el valor nominal.'
              : 'Racional: el descuento se calcula sobre el valor efectivo.'}
          </p>
        </fieldset>

        <fieldset class="mt-6">
          <legend class="text-sm font-semibold text-slate-900">
            ¿Qué querés calcular?
          </legend>
          <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-5" role="group" aria-label="Variable a calcular">
            <button type="button" data-target-option="D" aria-pressed={initialTarget === 'D' ? 'true' : 'false'} class={targetButtonClass}>
              Descuento
            </button>
            <button type="button" data-target-option="C" aria-pressed={initialTarget === 'C' ? 'true' : 'false'} class={targetButtonClass}>
              <span data-target-label="C">{initialEffectiveLabel}</span>
            </button>
            <button type="button" data-target-option="M" aria-pressed={initialTarget === 'M' ? 'true' : 'false'} class={targetButtonClass}>
              Valor nominal
            </button>
            <button type="button" data-target-option="rate" aria-pressed={initialTarget === 'rate' ? 'true' : 'false'} class={targetButtonClass}>
              Tasa
            </button>
            <button type="button" data-target-option="n" aria-pressed={initialTarget === 'n' ? 'true' : 'false'} class={targetButtonClass}>
              Tiempo
            </button>
          </div>
        </fieldset>

        <p class="mt-3 text-xs leading-5 text-slate-500">
          El campo marcado con «se calcula» se actualiza al presionar Calcular.
          Todos los campos se pueden editar.
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div>
            <div class="flex items-center justify-between gap-2">
              <label for="ds-D" class={fieldLabelClass}>Descuento (D)</label>
              <span data-target-badge="D" hidden={initialTarget !== 'D'} class="text-xs font-semibold text-sky-700">Se calcula</span>
            </div>
            <div data-target-box="D" data-target={initialTarget === 'D' ? 'true' : 'false'} class={inputBoxClass}>
              <span class="pl-3 text-sm text-slate-500" aria-hidden="true">US$</span>
              <input id="ds-D" data-field="D" value={fieldValue(initialValues.D, moneyInputOptions)} type="text" inputmode="decimal" autocomplete="off" placeholder="0" aria-describedby="ds-error-D" class={inputClass} />
            </div>
            <p id="ds-error-D" data-error="D" class="mt-1.5 hidden text-xs text-red-600"></p>
          </div>

          <div>
            <div class="flex items-center justify-between gap-2">
              <label for="ds-M" class={fieldLabelClass}>Valor nominal (M)</label>
              <span data-target-badge="M" hidden={initialTarget !== 'M'} class="text-xs font-semibold text-sky-700">Se calcula</span>
            </div>
            <div data-target-box="M" data-target={initialTarget === 'M' ? 'true' : 'false'} class={inputBoxClass}>
              <span class="pl-3 text-sm text-slate-500" aria-hidden="true">US$</span>
              <input id="ds-M" data-field="M" value={fieldValue(initialValues.M, moneyInputOptions)} type="text" inputmode="decimal" autocomplete="off" placeholder="0" aria-describedby="ds-error-M" class={inputClass} />
            </div>
            <p id="ds-error-M" data-error="M" class="mt-1.5 hidden text-xs text-red-600"></p>
          </div>

          <div>
            <div class="flex items-center justify-between gap-2">
              <label for="ds-C" data-c-label class={fieldLabelClass}>{initialEffectiveLabel} (C)</label>
              <span data-target-badge="C" hidden={initialTarget !== 'C'} class="text-xs font-semibold text-sky-700">Se calcula</span>
            </div>
            <div data-target-box="C" data-target={initialTarget === 'C' ? 'true' : 'false'} class={inputBoxClass}>
              <span class="pl-3 text-sm text-slate-500" aria-hidden="true">US$</span>
              <input id="ds-C" data-field="C" value={fieldValue(initialValues.C, moneyInputOptions)} type="text" inputmode="decimal" autocomplete="off" placeholder="0" aria-describedby="ds-error-C" class={inputClass} />
            </div>
            <p id="ds-error-C" data-error="C" class="mt-1.5 hidden text-xs text-red-600"></p>
          </div>

          <div>
            <div class="flex items-center justify-between gap-2">
              <label for="ds-rate" data-rate-label class={fieldLabelClass}>{initialRateLabel} ({initialRateSymbol})</label>
              <span data-target-badge="rate" hidden={initialTarget !== 'rate'} class="text-xs font-semibold text-sky-700">Se calcula</span>
            </div>
            <div data-target-box="rate" data-target={initialTarget === 'rate' ? 'true' : 'false'} class={inputBoxClass}>
              <input id="ds-rate" data-field="rate" value={fieldValue(initialValues.rate)} type="text" inputmode="decimal" autocomplete="off" placeholder="0" aria-describedby="ds-error-rate" class={inputClass} />
              <span class="pr-3 text-sm text-slate-500" aria-hidden="true">%</span>
            </div>
            <p id="ds-error-rate" data-error="rate" class="mt-1.5 hidden text-xs text-red-600"></p>
          </div>

          <div>
            <label for="ds-rate-type" class={fieldLabelClass}>Tipo de tasa</label>
            <select id="ds-rate-type" data-rate-type class={`${selectClass} mt-2`}>
              {rateTypeOptions.map(([value, config]) => (
                <option value={value} selected={initialValues.rateType === value}>{config.label}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="ds-time-unit" class={fieldLabelClass}>Unidad de tiempo</label>
            <select id="ds-time-unit" data-time-unit class={`${selectClass} mt-2`}>
              {timeUnitOptions.map(([value, config]) => (
                <option value={value} selected={initialValues.timeUnit === value}>{config.label}</option>
              ))}
            </select>
          </div>

          <div>
            <div class="flex items-center justify-between gap-2">
              <label for="ds-n" class={fieldLabelClass}>Tiempo (n)</label>
              <span data-target-badge="n" hidden={initialTarget !== 'n'} class="text-xs font-semibold text-sky-700">Se calcula</span>
            </div>
            <div data-target-box="n" data-target={initialTarget === 'n' ? 'true' : 'false'} class={`${inputBoxClass} mt-2`}>
              <input id="ds-n" data-field="n" value={fieldValue(initialValues.n)} type="text" inputmode="decimal" autocomplete="off" placeholder="0" aria-describedby="ds-error-n" class={inputClass} />
            </div>
            <p id="ds-error-n" data-error="n" class="mt-1.5 hidden text-xs text-red-600"></p>
          </div>

          <fieldset>
            <legend class={fieldLabelClass}>Base de días</legend>
            <div class="mt-2 grid grid-cols-2 gap-2">
              <label class="cursor-pointer">
                <input type="radio" name="ds-year-days" value="360" data-year-days checked={initialYearDays === 360} class="peer sr-only" />
                <span class="block rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-center text-xs font-semibold text-slate-600 transition peer-checked:border-sky-700 peer-checked:bg-sky-700 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-sky-600 peer-focus-visible:ring-offset-2">
                  360 comercial
                </span>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="ds-year-days" value="365" data-year-days checked={initialYearDays === 365} class="peer sr-only" />
                <span class="block rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-center text-xs font-semibold text-slate-600 transition peer-checked:border-sky-700 peer-checked:bg-sky-700 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-sky-600 peer-focus-visible:ring-offset-2">
                  365 calendario
                </span>
              </label>
            </div>
          </fieldset>
        </div>

        <div class="mt-6 rounded-xl border border-slate-200 bg-slate-50 px-4 py-4">
          <p class="text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">
            Conversión automática
          </p>
          <dl class="mt-3 space-y-2 text-sm">
            <div class="flex gap-2">
              <dt class="w-16 shrink-0 text-slate-500">Tasa</dt>
              <dd data-conversion-rate class="text-slate-700">—</dd>
            </div>
            <div class="flex gap-2">
              <dt class="w-16 shrink-0 text-slate-500">Tiempo</dt>
              <dd data-conversion-periods class="text-slate-700">—</dd>
            </div>
          </dl>
        </div>

        <p data-stale hidden class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-900">
          Los datos cambiaron. Presioná Calcular para actualizar los resultados.
        </p>

        <div data-error-summary hidden role="alert" class="mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          <p class="font-semibold">Revisá los datos:</p>
          <ul data-error-list class="mt-1 list-inside list-disc"></ul>
        </div>

        <div class="mt-6 grid gap-2">
          <button type="submit" class="inline-flex w-full items-center justify-center rounded-lg bg-sky-700 px-4 py-3 text-sm font-semibold text-white transition hover:bg-sky-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2">
            Calcular
          </button>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" data-action="reset" class={secondaryButtonClass}>Restablecer</button>
            <button type="button" data-action="clear" class={secondaryButtonClass}>Limpiar</button>
          </div>
          <p data-action-status role="status" aria-live="polite" class="min-h-5 text-xs text-slate-500"></p>
        </div>
      </form>
    </div>

    <div class="min-w-0 lg:sticky lg:top-24">
      <div class="rounded-2xl border border-slate-200 bg-white">
        <div class="flex flex-col gap-4 border-b border-slate-200 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
          <div>
            <h3 class="font-display text-2xl text-ink">Gráficas</h3>
            <p class="mt-1 text-sm text-slate-500">Se actualizan al calcular.</p>
          </div>
          <div class="flex flex-wrap gap-1 rounded-lg bg-slate-100 p-1" role="group" aria-label="Tipo de gráfica">
            <button type="button" data-chart-tab="composition" aria-pressed="true" class={chartTabClass}>Composición</button>
            <button type="button" data-chart-tab="comparison" aria-pressed="false" class={chartTabClass}>Comparación</button>
            <button type="button" data-chart-tab="term" aria-pressed="false" class={chartTabClass}>Plazo</button>
          </div>
        </div>

        <div class="px-4 py-5 sm:px-6">
          <div data-chart-panel="composition">
            <div data-chart-empty hidden class="flex h-72 items-center justify-center rounded-xl border border-dashed border-slate-200 bg-slate-50 px-6 text-center text-sm text-slate-500">
              Calculá el ejercicio para ver la gráfica.
            </div>
            <div data-chart-content>
              <div class="relative h-72">
                <canvas data-chart-canvas="composition" role="img" aria-label="Comparación entre valor efectivo, descuento y valor nominal" class="block h-full w-full max-w-full"></canvas>
              </div>
              <details class="mt-4 text-xs text-slate-500">
                <summary class="cursor-pointer font-medium text-slate-600">Ver datos de la gráfica</summary>
                <div data-chart-table="composition" class="mt-3 overflow-x-auto"></div>
              </details>
            </div>
          </div>

          <div data-chart-panel="comparison" hidden>
            <div data-chart-empty hidden class="flex h-72 items-center justify-center rounded-xl border border-dashed border-slate-200 bg-slate-50 px-6 text-center text-sm text-slate-500">
              Calculá el ejercicio para ver la gráfica.
            </div>
            <div data-chart-content>
              <div class="relative h-72">
                <canvas data-chart-canvas="comparison" role="img" aria-label="Comparación entre descuento comercial y descuento racional" class="block h-full w-full max-w-full"></canvas>
              </div>
              <details class="mt-4 text-xs text-slate-500">
                <summary class="cursor-pointer font-medium text-slate-600">Ver datos de la gráfica</summary>
                <div data-chart-table="comparison" class="mt-3 overflow-x-auto"></div>
              </details>
            </div>
          </div>

          <div data-chart-panel="term" hidden>
            <div data-chart-empty hidden class="flex h-72 items-center justify-center rounded-xl border border-dashed border-slate-200 bg-slate-50 px-6 text-center text-sm text-slate-500">
              Calculá el ejercicio para ver la gráfica.
            </div>
            <div data-chart-content>
              <div class="relative h-72">
                <canvas data-chart-canvas="term" role="img" aria-label="Descuento según el tiempo hasta el vencimiento" class="block h-full w-full max-w-full"></canvas>
              </div>
              <details class="mt-4 text-xs text-slate-500">
                <summary class="cursor-pointer font-medium text-slate-600">Ver datos de la gráfica</summary>
                <div data-chart-table="term" class="mt-3 overflow-x-auto"></div>
              </details>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <p data-live-status class="sr-only" aria-live="polite"></p>

  <section data-results hidden class="mt-12">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="flex items-center gap-2.5 text-sm font-semibold text-slate-700">
          <span class="h-px w-6 bg-sky-600" aria-hidden="true"></span>
          Resolución
        </p>
        <h3 class="mt-2 font-display text-3xl tracking-[-0.01em] text-ink sm:text-4xl">Resultados</h3>
      </div>
      <p data-results-target class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-600">
        Descuento
      </p>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[0.85fr_1.15fr]">
      <div class="space-y-4">
        <div class="rounded-2xl bg-[#0b3a55] px-6 py-7 text-white">
          <p data-result-label class="text-sm text-sky-200">Descuento</p>
          <p data-result-value class="mt-2 font-display text-4xl leading-none tracking-[-0.02em] sm:text-5xl">—</p>
          <p data-result-note class="mt-4 max-w-sm text-sm leading-6 text-slate-300"></p>
        </div>

        <dl class="overflow-hidden rounded-xl border border-slate-200 bg-white">
          <div class="flex items-center justify-between gap-4 border-b border-slate-100 px-5 py-3.5">
            <dt class="text-sm text-slate-500">Descuento</dt>
            <dd data-summary-discount class="text-sm font-semibold tabular-nums text-ink">—</dd>
          </div>
          <div class="flex items-center justify-between gap-4 border-b border-slate-100 px-5 py-3.5">
            <dt data-summary-effective-label class="text-sm text-slate-500">Valor efectivo</dt>
            <dd data-summary-effective class="text-sm font-semibold tabular-nums text-ink">—</dd>
          </div>
          <div class="flex items-center justify-between gap-4 px-5 py-3.5">
            <dt class="text-sm text-slate-500">Valor nominal</dt>
            <dd data-summary-nominal class="text-sm font-semibold tabular-nums text-ink">—</dd>
          </div>
        </dl>
      </div>

      <div class="space-y-4">
        <div class="rounded-xl border border-slate-200 bg-white px-5 py-5">
          <p class="text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">Fórmula utilizada</p>
          <p data-formula-expression class="mt-3 font-display text-2xl italic text-ink">—</p>
          <p data-formula-substitution class="mt-3 overflow-x-auto text-sm leading-6 text-slate-600">—</p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white px-5 py-5">
          <p class="text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">Procedimiento</p>
          <ol data-steps class="mt-3 space-y-2.5 text-sm leading-6 text-slate-600"></ol>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white px-5 py-5">
          <p class="text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">Datos y conversiones</p>
          <dl data-input-summary class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2"></dl>
        </div>
      </div>
    </div>
  </section>

  <div data-results-empty class="mt-12 rounded-2xl border border-dashed border-slate-300 bg-white/50 px-6 py-12 text-center">
    <p class="font-display text-2xl text-ink">Completá los datos y presioná Calcular</p>
    <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
      La resolución paso a paso y las gráficas van a aparecer acá.
    </p>
  </div>
</section>

<script>
  import {
    CRITERIA,
    RATE_TYPES,
    TARGETS,
    TIME_UNITS,
    formatInputNumber,
    formatMoney,
    formatNumber,
    formatPercent,
    fromAnnualRate,
    normalizeYearDays,
    parseNumber,
    solveDiscount,
    timeToYears,
    toAnnualRate,
  } from '../scripts/discount.js';
  import {
    buildDiscountChartData,
    createDiscountCharts,
    resizeDiscountCharts,
    updateDiscountCharts,
  } from '../scripts/discount-charts.js';
  import { discountExercises } from '../data/discount-exercises.js';

  const root = document.querySelector('[data-discount-calculator]');

  if (root) {
    const exercises = discountExercises;
    const initialExercise = exercises[0] ?? null;

    const form = root.querySelector('[data-calculator-form]');
    const exerciseSelect = root.querySelector('[data-exercise-select]');
    const exerciseHeading = root.querySelector('[data-exercise-heading]');
    const exerciseStatement = root.querySelector('[data-exercise-statement]');
    const exerciseNote = root.querySelector('[data-exercise-note]');
    const criterionHelp = root.querySelector('[data-criterion-help]');
    const cLabel = root.querySelector('[data-c-label]');
    const rateLabel = root.querySelector('[data-rate-label]');
    const targetCLabel = root.querySelector('[data-target-label="C"]');
    const summaryEffectiveLabel = root.querySelector('[data-summary-effective-label]');
    const fields = {
      D: root.querySelector('[data-field="D"]'),
      C: root.querySelector('[data-field="C"]'),
      M: root.querySelector('[data-field="M"]'),
      rate: root.querySelector('[data-field="rate"]'),
      n: root.querySelector('[data-field="n"]'),
    };
    const rateTypeSelect = root.querySelector('[data-rate-type]');
    const timeUnitSelect = root.querySelector('[data-time-unit]');
    const yearDaysInputs = [...root.querySelectorAll('[data-year-days]')];
    const criterionButtons = [...root.querySelectorAll('[data-criterion-option]')];
    const targetButtons = [...root.querySelectorAll('[data-target-option]')];
    const targetBoxes = {
      D: root.querySelector('[data-target-box="D"]'),
      C: root.querySelector('[data-target-box="C"]'),
      M: root.querySelector('[data-target-box="M"]'),
      rate: root.querySelector('[data-target-box="rate"]'),
      n: root.querySelector('[data-target-box="n"]'),
    };
    const targetBadges = {
      D: root.querySelector('[data-target-badge="D"]'),
      C: root.querySelector('[data-target-badge="C"]'),
      M: root.querySelector('[data-target-badge="M"]'),
      rate: root.querySelector('[data-target-badge="rate"]'),
      n: root.querySelector('[data-target-badge="n"]'),
    };
    const errorSummary = root.querySelector('[data-error-summary]');
    const errorList = root.querySelector('[data-error-list]');
    const errorElements = {
      D: root.querySelector('[data-error="D"]'),
      C: root.querySelector('[data-error="C"]'),
      M: root.querySelector('[data-error="M"]'),
      rate: root.querySelector('[data-error="rate"]'),
      n: root.querySelector('[data-error="n"]'),
    };
    const conversionRate = root.querySelector('[data-conversion-rate]');
    const conversionPeriods = root.querySelector('[data-conversion-periods]');
    const staleNotice = root.querySelector('[data-stale]');
    const actionStatus = root.querySelector('[data-action-status]');
    const liveStatus = root.querySelector('[data-live-status]');

    const results = root.querySelector('[data-results]');
    const resultsEmpty = root.querySelector('[data-results-empty]');
    const resultsTarget = root.querySelector('[data-results-target]');
    const resultLabel = root.querySelector('[data-result-label]');
    const resultValue = root.querySelector('[data-result-value]');
    const resultNote = root.querySelector('[data-result-note]');
    const summaryDiscount = root.querySelector('[data-summary-discount]');
    const summaryEffective = root.querySelector('[data-summary-effective]');
    const summaryNominal = root.querySelector('[data-summary-nominal]');
    const formulaExpression = root.querySelector('[data-formula-expression]');
    const formulaSubstitution = root.querySelector('[data-formula-substitution]');
    const stepsList = root.querySelector('[data-steps]');
    const inputSummary = root.querySelector('[data-input-summary]');

    const chartTabs = [...root.querySelectorAll('[data-chart-tab]')];
    const chartPanels = [...root.querySelectorAll('[data-chart-panel]')];
    const chartCanvases = {
      composition: root.querySelector('[data-chart-canvas="composition"]'),
      comparison: root.querySelector('[data-chart-canvas="comparison"]'),
      term: root.querySelector('[data-chart-canvas="term"]'),
    };
    const chartTables = {
      composition: root.querySelector('[data-chart-table="composition"]'),
      comparison: root.querySelector('[data-chart-table="comparison"]'),
      term: root.querySelector('[data-chart-table="term"]'),
    };

    const state = {
      target: initialExercise?.target ?? 'D',
      criterion: initialExercise?.criterion ?? 'comercial',
      baseline: null,
      lastResult: null,
      hasCalculated: false,
      charts: null,
      activeChart: 'composition',
    };

    const moneyFields = new Set(['D', 'C', 'M']);
    const moneyInputOptions = {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    };
    const rateResultOptions = {
      minimumFractionDigits: 0,
      maximumFractionDigits: 4,
    };
    const timeResultOptions = {
      minimumFractionDigits: 0,
      maximumFractionDigits: 4,
    };

    function getYearDays() {
      const selected = yearDaysInputs.find((input) => input.checked);
      return normalizeYearDays(selected?.value);
    }

    function readFieldValue(fieldName) {
      const field = fields[fieldName];
      if (!field) return '';
      return field.dataset.preciseValue ?? field.value;
    }

    function getFormValues() {
      return {
        target: state.target,
        criterion: state.criterion,
        D: readFieldValue('D'),
        C: readFieldValue('C'),
        M: readFieldValue('M'),
        rate: readFieldValue('rate'),
        n: readFieldValue('n'),
        timeUnit: timeUnitSelect.value,
        rateType: rateTypeSelect.value,
        yearDays: getYearDays(),
      };
    }

    function setStatus(message) {
      actionStatus.textContent = message;
    }

    function announce(message) {
      liveStatus.textContent = '';
      window.requestAnimationFrame(() => {
        liveStatus.textContent = message;
      });
    }

    function setFieldValue(fieldName, value, options) {
      const field = fields[fieldName];
      if (!field) return;

      if (value === null || value === undefined || value === '') {
        field.value = '';
        delete field.dataset.preciseValue;
        return;
      }

      const parsed = typeof value === 'number' ? value : parseNumber(value);
      if (Number.isFinite(parsed)) {
        field.value = formatInputNumber(
          parsed,
          options ?? (moneyFields.has(fieldName) ? moneyInputOptions : undefined)
        );
        field.dataset.preciseValue = String(parsed).replace('.', ',');
        return;
      }

      field.value = String(value);
      delete field.dataset.preciseValue;
    }

    function setFields(values) {
      setFieldValue('D', values.D);
      setFieldValue('C', values.C);
      setFieldValue('M', values.M);
      setFieldValue('rate', values.rate);
      setFieldValue('n', values.n);
      rateTypeSelect.value = values.rateType ?? 'anual';
      timeUnitSelect.value = values.timeUnit ?? 'meses';
      const yearDays = normalizeYearDays(values.yearDays);
      yearDaysInputs.forEach((input) => {
        input.checked = Number(input.value) === yearDays;
      });
    }

    function setTarget(target) {
      state.target = TARGETS[target] ? target : 'D';
      updateTargetUi();
    }

    function updateTargetUi() {
      targetButtons.forEach((button) => {
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.targetOption === state.target)
        );
      });

      Object.entries(targetBoxes).forEach(([key, box]) => {
        box.dataset.target = String(key === state.target);
      });

      Object.entries(targetBadges).forEach(([key, badge]) => {
        badge.hidden = key !== state.target;
      });
    }

    function updateCriterionUi() {
      const info = CRITERIA[state.criterion];
      criterionButtons.forEach((button) => {
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.criterionOption === state.criterion)
        );
      });
      cLabel.textContent = `${info.label === 'Comercial' ? 'Valor efectivo' : 'Valor actual'} (C)`;
      targetCLabel.textContent =
        info.label === 'Comercial' ? 'Valor efectivo' : 'Valor actual';
      summaryEffectiveLabel.textContent =
        info.label === 'Comercial' ? 'Valor efectivo' : 'Valor actual';
      rateLabel.textContent = `${info.rateLabel} (${info.rateSymbol})`;
      criterionHelp.textContent =
        info.label === 'Comercial'
          ? 'Comercial: el descuento se calcula sobre el valor nominal.'
          : 'Racional: el descuento se calcula sobre el valor efectivo.';
    }

    function convertRate(previousCriterion) {
      if (!previousCriterion || previousCriterion === state.criterion) return;

      const current = parseNumber(readFieldValue('rate'));
      if (!Number.isFinite(current) || current <= 0) return;

      const n = parseNumber(readFieldValue('n'));
      if (!Number.isFinite(n) || n <= 0) return;

      const rateType = rateTypeSelect.value;
      const nYears = timeToYears(n, timeUnitSelect.value, getYearDays());
      const annual = toAnnualRate(current, rateType);

      if (previousCriterion === 'comercial') {
        if (annual * nYears >= 1) return;
        const equivalent = annual / (1 - annual * nYears);
        setFieldValue(
          'rate',
          fromAnnualRate(equivalent, rateType),
          rateResultOptions
        );
      } else {
        const equivalent = annual / (1 + annual * nYears);
        setFieldValue(
          'rate',
          fromAnnualRate(equivalent, rateType),
          rateResultOptions
        );
      }
    }

    function setCriterion(criterion, { convert = false } = {}) {
      if (!CRITERIA[criterion]) return;
      const previous = state.criterion;
      state.criterion = criterion;
      updateCriterionUi();
      if (convert) convertRate(previous);
    }

    function clearFieldError(fieldName) {
      const errorElement = errorElements[fieldName];
      if (errorElement) {
        errorElement.textContent = '';
        errorElement.hidden = true;
      }

      const input = fields[fieldName];
      if (input) input.removeAttribute('aria-invalid');

      const box = targetBoxes[fieldName];
      if (box) box.dataset.invalid = 'false';
    }

    function clearErrors() {
      Object.keys(errorElements).forEach(clearFieldError);
      errorSummary.hidden = true;
      errorList.replaceChildren();
    }

    function showErrors(errors) {
      clearErrors();
      const messages = [];

      Object.entries(errors).forEach(([fieldName, message]) => {
        const errorElement = errorElements[fieldName];
        if (errorElement) {
          errorElement.textContent = message;
          errorElement.hidden = false;
        }

        const input = fields[fieldName];
        if (input) input.setAttribute('aria-invalid', 'true');

        const box = targetBoxes[fieldName];
        if (box) box.dataset.invalid = 'true';

        messages.push(message);
      });

      if (messages.length === 0) return;

      errorList.replaceChildren(
        ...messages.map((message) => {
          const item = document.createElement('li');
          item.textContent = message;
          return item;
        })
      );
      errorSummary.hidden = false;

      const firstInvalid = Object.keys(errors).find((fieldName) => fields[fieldName]);
      if (firstInvalid) fields[firstInvalid].focus();
    }

    function showStale() {
      if (!state.hasCalculated) return;
      staleNotice.hidden = false;
    }

    function hideStale() {
      staleNotice.hidden = true;
    }

    function updateConversions() {
      const rate = parseNumber(readFieldValue('rate'));
      const n = parseNumber(readFieldValue('n'));
      const rateType = rateTypeSelect.value;
      const timeUnit = timeUnitSelect.value;
      const yearDays = getYearDays();
      const rateFactorValue =
        rateType === 'mensual' ? 12 : rateType === 'semanal' ? 52 : 1;

      if (Number.isFinite(rate) && rate > 0) {
        const annual = (rate / 100) * rateFactorValue;
        conversionRate.textContent = `${formatPercent(rate, 4)} ${RATE_TYPES[rateType].label} = ${formatNumber(annual, 8)} anual.`;
      } else {
        conversionRate.textContent = 'Ingresá una tasa para ver la conversión.';
      }

      if (Number.isFinite(n) && n > 0) {
        const years =
          timeUnit === 'dias' ? n / yearDays : timeUnit === 'meses' ? n / 12 : n;
        conversionPeriods.textContent = `${formatNumber(n, 4)} ${TIME_UNITS[timeUnit].label} = ${formatNumber(years, 8)} años = ${formatNumber(years * yearDays, 4)} días (base ${yearDays}).`;
      } else {
        conversionPeriods.textContent = 'Ingresá un tiempo para ver la conversión.';
      }
    }

    function updateChartEmptyState(showEmpty) {
      root.querySelectorAll('[data-chart-empty]').forEach((element) => {
        element.hidden = !showEmpty;
      });
      root.querySelectorAll('[data-chart-content]').forEach((element) => {
        element.hidden = showEmpty;
      });
    }

    function renderTable(container, headers, rows) {
      container.replaceChildren();
      const table = document.createElement('table');
      table.className = 'w-full text-left text-xs';
      const thead = document.createElement('thead');
      const headRow = document.createElement('tr');
      headers.forEach((header) => {
        const th = document.createElement('th');
        th.className = 'border-b border-slate-200 pb-2 font-semibold text-slate-600';
        th.scope = 'col';
        th.textContent = header;
        headRow.append(th);
      });
      thead.append(headRow);
      const tbody = document.createElement('tbody');
      rows.forEach((row) => {
        const tr = document.createElement('tr');
        row.forEach((cell) => {
          const td = document.createElement('td');
          td.className = 'border-b border-slate-100 py-2 text-slate-600';
          td.textContent = cell;
          tr.append(td);
        });
        tbody.append(tr);
      });
      table.append(thead, tbody);
      container.append(table);
    }

    function renderChartTables(result) {
      const data = buildDiscountChartData(result);
      if (!data) return;

      renderTable(
        chartTables.composition,
        ['Concepto', 'Monto'],
        [
          ['Valor efectivo', formatMoney(result.summary.effective)],
          ['Descuento', formatMoney(result.summary.discount)],
          ['Valor nominal', formatMoney(result.summary.nominal)],
        ]
      );

      if (data.comparison.available) {
        renderTable(
          chartTables.comparison,
          ['Criterio', 'Descuento'],
          data.comparison.labels.map((label, index) => [
            label,
            formatMoney(data.comparison.values[index]),
          ])
        );
      } else {
        chartTables.comparison.textContent =
          'Ingresá una tasa y un tiempo para comparar los criterios.';
      }

      if (data.term.available) {
        renderTable(
          chartTables.term,
          ['Tiempo', 'Descuento'],
          data.term.labels.map((label, index) => [
            `${label} ${data.term.unit}`,
            formatMoney(data.term.values[index]),
          ])
        );
      } else {
        chartTables.term.textContent =
          'Ingresá una tasa y un tiempo para ver la evolución del descuento.';
      }
    }

    function panelIsVisible() {
      const panel = root.closest('[data-tab-panel]');
      return !panel || !panel.hidden;
    }

    function ensureCharts() {
      if (!panelIsVisible()) return false;
      if (state.charts) return true;

      state.charts = createDiscountCharts(
        {
          composition: chartCanvases.composition,
          comparison: chartCanvases.comparison,
          term: chartCanvases.term,
        },
        state.lastResult
      );
      if (state.lastResult) renderChartTables(state.lastResult);
      return true;
    }

    function updateChartsIfReady(result) {
      if (!result) return;
      if (state.charts) {
        updateDiscountCharts(state.charts, result);
        renderChartTables(result);
        return;
      }

      if (ensureCharts()) {
        updateDiscountCharts(state.charts, result);
        renderChartTables(result);
      }
    }

    function renderResult(result) {
      resultsTarget.textContent = result.result.label;
      resultLabel.textContent = result.result.label;
      resultValue.textContent = result.result.formatted;
      resultNote.textContent =
        result.criterion === 'comercial'
          ? 'Descuento comercial: se calcula sobre el valor nominal del documento.'
          : 'Descuento racional: se calcula sobre el valor efectivo del documento.';

      summaryDiscount.textContent = formatMoney(result.summary.discount);
      summaryEffective.textContent = formatMoney(result.summary.effective);
      summaryNominal.textContent = formatMoney(result.summary.nominal);

      formulaExpression.textContent = result.formula.expression;
      formulaSubstitution.textContent = result.formula.substitution;

      stepsList.replaceChildren(
        ...result.steps.map((step) => {
          const item = document.createElement('li');
          item.textContent = step;
          if (step.startsWith('Resultado:')) {
            item.className = 'font-semibold text-ink';
          }
          return item;
        })
      );

      const dataRows = [
        ['Criterio', result.criterionInfo.longLabel],
        ['Descuento', formatMoney(result.summary.discount)],
        [
          result.criterion === 'comercial' ? 'Valor efectivo' : 'Valor actual',
          formatMoney(result.summary.effective),
        ],
        ['Valor nominal', formatMoney(result.summary.nominal)],
        [result.criterionInfo.rateLabel, `${formatPercent(result.values.rate, 4)} ${RATE_TYPES[result.rateType].label}`],
        ['Tasa anual', formatPercent(result.conversions.rateAnnual * 100, 4)],
        ['Tiempo ingresado', `${formatNumber(result.values.n, 4)} ${TIME_UNITS[result.timeUnit].label}`],
        ['Tiempo en años', formatNumber(result.conversions.nYears, 8)],
        ['Días base', `${result.yearDays}`],
      ];

      inputSummary.replaceChildren(
        ...dataRows.map(([term, description]) => {
          const row = document.createElement('div');
          row.className = 'flex items-baseline justify-between gap-3 border-b border-slate-100 pb-1.5';
          const dt = document.createElement('dt');
          dt.className = 'shrink-0 text-slate-500';
          dt.textContent = term;
          const dd = document.createElement('dd');
          dd.className = 'text-right font-medium tabular-nums text-ink';
          dd.textContent = description;
          row.append(dt, dd);
          return row;
        })
      );

      results.hidden = false;
      resultsEmpty.hidden = true;
      hideStale();
    }

    function calculate({ silent = false } = {}) {
      const result = solveDiscount(getFormValues());
      clearErrors();

      if (!result.ok) {
        showErrors(result.errors);
        showStale();
        if (!silent) announce('No se pudo calcular. Revisá los datos.');
        return false;
      }

      state.lastResult = result;
      state.hasCalculated = true;
      updateChartEmptyState(false);
      renderResult(result);

      setFieldValue(
        result.target,
        result.result.value,
        result.target === 'rate'
          ? rateResultOptions
          : result.target === 'n'
            ? timeResultOptions
            : undefined
      );

      updateConversions();
      updateChartsIfReady(result);

      if (!silent) {
        setStatus('Resultado actualizado.');
        announce(`${result.result.label}: ${result.result.formatted}`);
      }

      return true;
    }

    function syncExerciseSelect(presetId) {
      if (presetId) exerciseSelect.value = presetId;
    }

    function snapshotFromExercise(exercise) {
      return {
        presetId: exercise.id,
        title: exercise.title,
        statement: exercise.statement,
        note: exercise.note ?? null,
        values: { ...exercise.data },
        target: exercise.target,
        criterion: exercise.criterion,
        rateType: exercise.data?.rateType,
        timeUnit: exercise.data?.timeUnit,
        yearDays: exercise.yearDays ?? 360,
      };
    }

    function applySnapshot(snapshot, { calculateAfter = true } = {}) {
      if (!snapshot) return;

      state.baseline = snapshot;
      exerciseHeading.textContent = snapshot.title;
      exerciseStatement.textContent = snapshot.statement;
      exerciseNote.textContent = snapshot.note ?? '';
      exerciseNote.hidden = !snapshot.note;
      syncExerciseSelect(snapshot.presetId);
      setCriterion(snapshot.criterion ?? 'comercial');
      setTarget(snapshot.target ?? 'D');
      setFields({
        D: snapshot.values?.D ?? null,
        C: snapshot.values?.C ?? null,
        M: snapshot.values?.M ?? null,
        rate: snapshot.values?.rate ?? null,
        n: snapshot.values?.n ?? null,
        rateType: snapshot.rateType ?? 'anual',
        timeUnit: snapshot.timeUnit ?? 'meses',
        yearDays: snapshot.yearDays ?? 360,
      });
      clearErrors();
      hideStale();
      setStatus('');

      if (calculateAfter) {
        calculate({ silent: true });
      } else {
        updateConversions();
      }
    }

    function loadExerciseById(id) {
      const exercise = exercises.find((item) => item.id === id);
      if (!exercise) return;

      const snapshot = snapshotFromExercise(exercise);
      state.baseline = snapshot;
      applySnapshot(snapshot);
      window.requestAnimationFrame(() => resizeDiscountCharts(state.charts));
    }

    function resetExercise() {
      if (!state.baseline) return;
      applySnapshot(state.baseline);
      setStatus('Datos restablecidos.');
      announce('Datos restablecidos al ejercicio original.');
    }

    function clearExercise() {
      Object.values(fields).forEach((field) => {
        field.value = '';
        delete field.dataset.preciseValue;
      });
      state.lastResult = null;
      state.hasCalculated = false;
      clearErrors();
      hideStale();
      updateConversions();
      results.hidden = true;
      resultsEmpty.hidden = false;
      updateChartEmptyState(true);
      setStatus('Formulario limpio.');
      announce('Formulario limpio. Podés completar nuevos datos.');
    }

    function setChartTab(name) {
      state.activeChart = name;
      chartTabs.forEach((tab) => {
        tab.setAttribute('aria-pressed', String(tab.dataset.chartTab === name));
      });
      chartPanels.forEach((panel) => {
        panel.hidden = panel.dataset.chartPanel !== name;
      });

      ensureCharts();
      window.requestAnimationFrame(() => resizeDiscountCharts(state.charts));
    }

    criterionButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setCriterion(button.dataset.criterionOption, { convert: true });
        updateConversions();
        showStale();
      });
    });

    targetButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setTarget(button.dataset.targetOption);
        showStale();
      });
    });

    exerciseSelect.addEventListener('change', () => {
      loadExerciseById(exerciseSelect.value);
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      calculate();
    });

    form.addEventListener('input', (event) => {
      const fieldName = event.target.dataset.field;
      if (!fieldName) return;
      delete event.target.dataset.preciseValue;
      clearFieldError(fieldName);
      updateConversions();
      showStale();
    });

    form.addEventListener('change', (event) => {
      if (event.target.matches('[data-rate-type], [data-time-unit], [data-year-days]')) {
        updateConversions();
        showStale();
      }
    });

    root.querySelector('[data-action="reset"]').addEventListener('click', resetExercise);
    root.querySelector('[data-action="clear"]').addEventListener('click', clearExercise);

    chartTabs.forEach((tab) => {
      tab.addEventListener('click', () => setChartTab(tab.dataset.chartTab));
    });

    document.addEventListener('topic-tab-change', (event) => {
      if (event.detail?.tab !== 'ejercicios') return;
      window.requestAnimationFrame(() => {
        ensureCharts();
        resizeDiscountCharts(state.charts);
      });
    });

    const initialSnapshot = initialExercise
      ? snapshotFromExercise(initialExercise)
      : null;

    if (initialSnapshot) {
      state.baseline = initialSnapshot;
      applySnapshot(initialSnapshot);
      setChartTab('composition');
    } else {
      updateChartEmptyState(true);
      updateConversions();
    }
  }
</script>
